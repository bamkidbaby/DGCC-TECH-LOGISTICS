<%- include('partials/header.ejs') %>

    <style>
        :root {
            --bg-color: #fff;
            --text-color: #222;
            --primary-color: #2c3192;
            --accent-color: #e2b40e;
        }

        /* Checkout Section */
        .checkout-section {
            padding: 60px 20px;
            background: var(--bg-color);
            color: var(--text-color);
        }

        .checkout-section .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .checkout-head {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        /* Customer Info Banner */
        .info-banner {
            background: #f0f0f0;
            padding: 15px 20px;
            border-radius: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .info-banner a {
            color: var(--accent-color);
            text-decoration: none;
            font-weight: 600;
        }

        /* Checkout Layout */
        .checkout-layout {
            display: grid;
            grid-template-columns: 1.5fr 0.85fr;
            gap: 40px;
        }

        /* Billing Details */
        .billing-section {
            background: var(--bg-color);
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        }

        .section-title {
            font-size: 24px;
            color: var(--primary-color);
            margin-bottom: 25px;
            font-weight: 600;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-color);
            font-weight: 500;
            font-size: 14px;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 14px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            transition: border 0.3s;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--accent-color);
        }

        .form-group textarea {
            resize: vertical;
            min-height: 100px;
        }

        /* Checkbox */
        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 20px;
        }

        .checkbox-group input[type="checkbox"] {
            width: auto;
        }

        /* Order Summary */
        .order-summary {
            background: var(--bg-color);
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
            height: fit-content;
        }

        .summary-item {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #f0f0f0;
        }

        .summary-label {
            color: #666;
            font-size: 14px;
        }

        .summary-value {
            color: var(--text-color);
            font-weight: 600;
        }

        .summary-total {
            padding: 20px 0;
            font-size: 20px;
            font-weight: 700;
        }

        .summary-total .summary-value {
            color: var(--accent-color);
        }

        /* Bank Info */
        .bank-transfer-info {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin: 20px 0;
            border-left: 4px solid var(--accent-color);
        }

        .bank-transfer-info p {
            color: #666;
            font-size: 13px;
            line-height: 1.6;
            margin: 0;
        }

        /* Delivery Method */
        .delivery-method {
            margin: 20px 0;
        }

        .delivery-option {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px;
            margin-bottom: 10px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .delivery-option:hover {
            border-color: var(--accent-color);
            background: #fffaf0;
        }

        .delivery-option input[type="radio"] {
            accent-color: var(--accent-color);
        }

        /* Place Order Button */
        .place-order-btn {
            width: 100%;
            background: var(--accent-color);
            color: #fff;
            padding: 16px;
            border: none;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 20px;
        }

        .place-order-btn:hover {
            background: #d19c07;
            transform: translateY(-2px);
        }

        /* Responsive */
        @media (max-width: 968px) {
            .checkout-section .container {
                max-width: 95%;
                margin: 0 auto;
            }

            .checkout-layout {
                grid-template-columns: 1fr;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .checkout-head {
                grid-template-columns: 1fr;
                gap: 10px;
            }
        }
    </style>

    <!-- Page Hero -->
    <section class="page-hero">
        <div class="page-title">
            <div class="vertical-line"></div>
            <div class="page-text">
                <h1>Checkout</h1>
                <div class="breadcrumb">
                    <a href="/">Home</a>
                    <i class="fa-solid fa-angle-right"></i>
                    <span>Checkout</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Checkout Section -->
    <section class="checkout-section">
        <div class="container">
            <div class="checkout-head">
                <div class="info-banner">
                    <span>Have a coupon? <a href="#">Click here</a> and enter your code</span>
                </div>

                <div class="info-banner">
                    <span>Returning Customer? <a href="#">Click here to login</a></span>
                </div>
            </div>

            <div class="checkout-layout">
                <!-- Billing Details -->
                <div class="billing-section">
                    <h2 class="section-title">Billing Details</h2>
                    <form>
                        <div class="form-row">
                            <div class="form-group">
                                <label>First name*</label>
                                <input type="text" placeholder="First Name" required>
                            </div>
                            <div class="form-group">
                                <label>Last name*</label>
                                <input type="text" placeholder="Last Name" required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Country</label>
                            <select required>
                                <option>United States</option>
                                <option>Canada</option>
                                <option>United Kingdom</option>
                                <option>Australia</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Street address*</label>
                            <input type="text" placeholder="Street address" required>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>State*</label>
                                <input type="text" placeholder="State" required>
                            </div>
                            <div class="form-group">
                                <label>Postcode*</label>
                                <input type="text" placeholder="Postcode" required>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Phone</label>
                                <input type="tel" placeholder="Phone" required>
                            </div>
                            <div class="form-group">
                                <label>Email Address</label>
                                <input type="email" placeholder="Email Address" required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Company (Optional)</label>
                            <input type="text" placeholder="Company">
                        </div>

                        <div class="form-group">
                            <label>Order notes (Optional)</label>
                            <textarea placeholder="Order message"></textarea>
                        </div>

                        <div class="checkbox-group">
                            <input type="checkbox" id="ship-address">
                            <label for="ship-address">Ship to another Address</label>
                        </div>
                    </form>
                </div>

                <!-- Order Summary -->
                <div class="order-summary">
                    <h2 class="section-title">Your order</h2>

                    <div class="summary-item">
                        <span class="summary-label">Products</span>
                        <span class="summary-label">Subtotal</span>
                    </div>

                    <div class="summary-item">
                        <span class="summary-label">John's Elite 761</span>
                        <span class="summary-value">$40.00</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">John's Elite 761</span>
                        <span class="summary-value">$40.00</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">John's Elite 761</span>
                        <span class="summary-value">$40.00</span>
                    </div>

                    <div class="summary-item">
                        <span class="summary-label">Subtotal</span>
                        <span class="summary-value">$242.00</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Shipping Cost</span>
                        <span class="summary-value">$10.00</span>
                    </div>

                    <div class="summary-item summary-total">
                        <span class="summary-label">Total</span>
                        <span class="summary-value">$283.00</span>
                    </div>

                    <div class="bank-transfer-info">
                        <p><strong>Note:</strong> Your post payment details info to your local accountant order will not
                            note shipment immediately to our account...</p>
                    </div>

                    <div class="delivery-method">
                        <div class="delivery-option">
                            <input type="radio" name="delivery" id="cash" checked>
                            <label for="cash">Cash On Delivery (COD)</label>
                        </div>
                    </div>

                    <button class="place-order-btn">Place Your Order</button>
                </div>
            </div>
        </div>
    </section>

    <%- include('partials/footer.ejs') %>