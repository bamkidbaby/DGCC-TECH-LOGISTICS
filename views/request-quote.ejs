<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Request Quote</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f5f5f5;
        }

        /* Page Hero */
        .page-hero {
            background: linear-gradient(rgba(26, 35, 55, 0.7), rgba(26, 35, 55, 0.7)), url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=1600&h=400&fit=crop') center/cover;
            padding: 100px 0 60px;
            color: white;
            text-align: center;
        }

        .page-hero h1 {
            font-size: 48px;
            margin-bottom: 15px;
        }

        .breadcrumb {
            display: flex;
            justify-content: center;
            gap: 10px;
            font-size: 14px;
        }

        .breadcrumb a {
            color: white;
            text-decoration: none;
        }

        .breadcrumb span {
            color: #FF5722;
        }

        /* Service Steps */
        .service-steps {
            background: white;
            padding: 60px 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .steps-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 40px;
            text-align: center;
        }

        .step-box {
            position: relative;
        }

        .step-icon-box {
            width: 80px;
            height: 80px;
            background: #1a2337;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            font-size: 36px;
            transition: all 0.3s;
        }

        .step-box.active .step-icon-box {
            background: #FF5722;
        }

        .step-title {
            font-size: 20px;
            color: #1a1a2e;
            font-weight: 600;
        }

        .step-line {
            position: absolute;
            top: 40px;
            left: 60%;
            width: 80%;
            height: 2px;
            background: #e0e0e0;
        }

        .steps-grid .step-box:last-child .step-line {
            display: none;
        }

        /* Quote Form Section */
        .quote-form-section {
            padding: 80px 20px;
            background: #f5f5f5;
        }

        .quote-container {
            display: grid;
            grid-template-columns: 1fr 1.5fr;
            gap: 40px;
            align-items: start;
        }

        .quote-image {
            width: 100%;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        }

        .quote-form-box {
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        }

        .form-section-title {
            font-size: 20px;
            color: #1a1a2e;
            margin-bottom: 25px;
            font-weight: 600;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group label {
            font-size: 14px;
            color: #1a1a2e;
            margin-bottom: 8px;
            font-weight: 500;
        }

        .form-group input,
        .form-group select {
            padding: 14px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            transition: border 0.3s;
        }

        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: #FF5722;
        }

        .icon-input {
            position: relative;
        }

        .icon-input input {
            padding-left: 45px;
        }

        .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #FF5722;
        }

        .submit-btn {
            background: #FF5722;
            color: white;
            padding: 15px 40px;
            border: none;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .submit-btn:hover {
            background: #e64a19;
            transform: translateY(-2px);
        }

        @media (max-width: 1024px) {
            .quote-container {
                grid-template-columns: 1fr;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .steps-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <!-- Page Hero -->
    <section class="page-hero">
        <h1>Request Quote</h1>
        <div class="breadcrumb">
            <a href="#">Home</a> > <span>Request Quote</span>
        </div>
    </section>

    <!-- Service Steps -->
    <section class="service-steps">
        <div class="container">
            <div class="steps-grid">
                <div class="step-box">
                    <div class="step-icon-box">📦</div>
                    <div class="step-title">Transparent Pricing</div>
                    <div class="step-line"></div>
                </div>
                <div class="step-box active">
                    <div class="step-icon-box">📍</div>
                    <div class="step-title">Real Time Tracking</div>
                    <div class="step-line"></div>
                </div>
                <div class="step-box">
                    <div class="step-icon-box">💬</div>
                    <div class="step-title">24/7 Online Support</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Quote Form -->
    <section class="quote-form-section">
        <div class="container">
            <div class="quote-container">
                <div>
                    <img src="https://images.unsplash.com/photo-1566576721346-d4a3b4eaeb55?w=500&h=600&fit=crop"
                        alt="Truck" class="quote-image">
                </div>

                <div class="quote-form-box">
                    <h3 class="form-section-title">Personal Info</h3>
                    <form>
                        <div class="form-grid">
                            <div class="form-group">
                                <label>Your Name</label>
                                <div class="icon-input">
                                    <span class="input-icon">👤</span>
                                    <input type="text" placeholder="Your name">
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Your Email</label>
                                <div class="icon-input">
                                    <span class="input-icon">✉️</span>
                                    <input type="email" placeholder="Your email">
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Your Phone</label>
                                <div class="icon-input">
                                    <span class="input-icon">📞</span>
                                    <input type="tel" placeholder="Your phone">
                                </div>
                            </div>
                        </div>

                        <h3 class="form-section-title">Shipment Info</h3>
                        <div class="form-grid">
                            <div class="form-group">
                                <label>Freight Type</label>
                                <select>
                                    <option>Select type</option>
                                    <option>Air Freight</option>
                                    <option>Sea Freight</option>
                                    <option>Land Freight</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>City Departure</label>
                                <input type="text" placeholder="City">
                            </div>
                            <div class="form-group">
                                <label>Delivery City</label>
                                <input type="text" placeholder="City">
                            </div>
                        </div>

                        <div class="form-grid">
                            <div class="form-group">
                                <label>Incoterms</label>
                                <select>
                                    <option>Select</option>
                                    <option>FOB</option>
                                    <option>CIF</option>
                                    <option>EXW</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Date</label>
                                <input type="date">
                            </div>
                            <div class="form-group">
                                <label>Time</label>
                                <input type="time">
                            </div>
                        </div>

                        <button type="submit" class="submit-btn">Request A Quote →</button>
                    </form>
                </div>
            </div>
        </div>
    </section>
</body>

</html>