<%- include('partials/header.ejs') %>
    <link rel="stylesheet" href="styles/request-quote.css">
    </head>

    <body>
        <!-- Page Hero -->
        <section class="page-hero">
            <div class="page-title">
                <div class="vertical-line"></div>
                <div class="page-text">
                    <h1>Request Quote</h1>
                    <div class="breadcrumb">
                        <a href="/">Home</a> <i class="fas fa-arrow-right"></i> <span>Request Quote</span>
                    </div>
                </div>
            </div>
        </section>
        <!-- Service Steps -->
        <section class="service-steps">
            <div class="container">
                <div class="steps-grid">
                    <div class="step-box">
                        <div class="step-icon-box"><img
                                src="data:image/svg+xml;base64,"
                                alt=""></div>
                        <div class="step-title">Transparent Pricing</div>
                    </div>
                    <div class="step-box active">
                        <div class="step-icon-box"><img
                                src="data:image/svg+xml;base64,"
                                alt=""></div>
                        <div class="step-title">Real Time Tracking</div>
                    </div>
                    <div class="step-box">
                        <div class="step-icon-box"><img
                                src="data:image/svg+xml;base64,"
                                alt=""></div>
                        <div class="step-title">24/7 Online Support</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Quote Form -->
        <section class="quote-form-section">
            <div class="container">
                <div class="quote-container">
                    <div>
                        <img src="https://html.theme-village.com/transhub/demo/images/quote-thumb.jpg" alt="Truck"
                            class="quote-image">
                    </div>

                    <div class="quote-form-box">
                        <h3 class="form-section-title">Personal Info</h3>
                        <form>
                            <div class="form-grid">
                                <div class="form-group">
                                    <div class="icon-input">
                                        <span class="input-icon"><i class="fas fa-user"></i></span>
                                        <input type="text" placeholder="Your name">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="icon-input">
                                        <span class="input-icon"><i class="fas fa-envelope"></i></span>
                                        <input type="email" placeholder="Your email">
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="icon-input">
                                        <span class="input-icon"><i class="fas fa-phone"></i></span>
                                        <input type="tel" placeholder="Your phone">
                                    </div>
                                </div>
                            </div>

                            <h3 class="form-section-title">Shipment Info</h3>

                            <div class="form-grid">
                                <div class="form-group">
                                    <select>
                                        <option>Select type</option>
                                        <option>Air Freight</option>
                                        <option>Sea Freight</option>
                                        <option>Land Freight</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <input type="text" placeholder="City">
                                </div>

                                <div class="form-group">
                                    <input type="text" placeholder="City">
                                </div>
                            </div>

                            <div class="form-grid">
                                <div class="form-group">
                                    <select>
                                        <option>Select</option>
                                        <option>FOB</option>
                                        <option>CIF</option>
                                        <option>EXW</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <input type="date">
                                </div>

                                <div class="form-group">
                                    <input type="time">
                                </div>
                            </div>

                            <button type="submit" class="submit-btn">Request A Quote <i
                                    class="fas fa-arrow-right"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        </section>

        <%- include('partials/footer.ejs') %>