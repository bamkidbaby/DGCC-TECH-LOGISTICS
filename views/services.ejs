<%- include('partials/header.ejs') %>
    <style>
        :root {
            /* New Brand Colors */
            --bg-color: #fff;
            --text-color: #222;
            --primary-color: #2c3192;
            --accent-color: #e2b40e;

            /* Mapped to your existing system (so nothing breaks) */
            --primary-navy: var(--primary-color);
            --secondary-navy: #1f247a;

            --accent-orange: var(--accent-color);
            --accent-orange-light: #f0c93a;

            --text-light: #ffffff;
            --text-gray: #9aa3b2;

            --card-bg: #ffffff;
            --section-bg: #f6f7fb;
        }

        /* Services Section */
        .services {
            background: var(--section-bg);
            padding: 5rem 2rem;
        }

        .services .container {
            max-width: 1400px;
            margin: 0 auto;
            background: #fff;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-top: 3rem;
        }

        .service-card {
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
        }

        .service-image {
            height: 150px;
            position: relative;
            overflow: hidden;
            background-repeat: no-repeat;
            background-size: 120% 100%;
        }

        .service-content {
            padding: 2rem;
        }

        .service-title {
            font-family: 'Syne', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary-navy);
            margin-bottom: 1rem;
        }

        .service-description {
            color: #546e7a;
            margin-bottom: 1.5rem;
            line-height: 1.7;
        }

        .service-link {
            display: flex;
            padding: 0 0 15px 15px;
            align-items: flex-end;
            gap: 0.5rem;
            color: var(--accent-orange);
            font-weight: 600;
            text-decoration: none;
            transition: gap 0.3s;
        }

        .service-link:hover {
            gap: 1rem;
        }


        /* Contact Section */
        .contact-section {
            background: url("../images/imgi_10_whu-us-bg.jpg");
            padding: 5rem 6rem;
            position: relative;
            overflow: hidden;
            background-attachment: fixed;
        }



        .contact-container {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            position: relative;
            z-index: 1;
        }

        .contact-info h2 {
            font-family: 'Syne', sans-serif;
            font-size: 2.5rem;
            color: white;
            margin-bottom: 1rem;
            font-weight: 800;
        }

        .contact-info p {
            color: var(--text-gray);
            margin-bottom: 2rem;
            line-height: 1.8;
        }

        .info-items {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .info-icon {
            width: 50px;
            height: 50px;
            background: rgba(255, 87, 34, 0.1);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-orange);
            font-size: 1.3rem;
        }

        .info-text h4 {
            color: white;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }

        .info-text p {
            color: var(--text-gray);
            margin: 0;
        }

        .contact-details {
            background: white;
            padding: 1.5rem;
            border-radius: 12px;
            margin-top: 2rem;
        }

        .contact-details p {
            color: var(--primary-navy);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        /* Quote Form */
        .quote-form {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 2.5rem;
        }

        .form-title {
            font-family: 'Syne', sans-serif;
            font-size: 1.8rem;
            color: white;
            margin-bottom: 2rem;
            font-weight: 700;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            color: white;
            margin-bottom: 0.5rem;
            font-weight: 500;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            padding: 0.875rem 1rem;
            color: white;
            font-family: 'DM Sans', sans-serif;
            transition: all 0.3s;
        }

        .form-group input::placeholder,
        .form-group textarea::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            background: rgba(255, 255, 255, 0.15);
            border-color: var(--accent-orange);
        }

        .form-group textarea {
            resize: vertical;
            min-height: 100px;
        }

        .submit-button {
            background: var(--accent-orange);
            color: white;
            padding: 1rem 2.5rem;
            border: none;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 1rem;
            width: 100%;
            box-shadow: 0 4px 20px rgba(255, 87, 34, 0.3);
        }

        .submit-button:hover {
            background: var(--accent-orange-light);
            transform: translateY(-2px);
            box-shadow: 0 6px 30px rgba(255, 87, 34, 0.4);
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .contact-container {
                grid-template-columns: 1fr;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .hero h1 {
                font-size: 3rem;
            }
        }

        @media (max-width: 768px) {
            .nav-menu {
                display: none;
            }

            .services-grid {
                grid-template-columns: 1fr;
            }

            .hero h1 {
                font-size: 2.5rem;
            }
        }
    </style>

