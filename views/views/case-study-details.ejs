<%- include('partials/header.ejs') %>

    <style>
        :root {
            --bg-color: #fff;
            --text-color: #222;
            --primary-color: #2c3192;
            --accent-color: #e2b40e;
        }

        /* ================= CONTAINER ================= */
        .project-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 70px 0;
        }

        /* ================= LAYOUT ================= */
        .project-layout {
            display: grid;
            grid-template-columns: 2.5fr 1fr;
            gap: 40px;
        }

        /* ================= MAIN CONTENT ================= */
        .project-main {
            background: #ffffff;
            border-radius: 20px;
            padding: 45px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.05);
        }

        .project-hero-image {
            width: 100%;
            height: 420px;
            border-radius: 16px;
            object-fit: cover;
            margin-bottom: 35px;
        }

        /* ================= TEXT ================= */
        .project-header h1 {
            font-family: 'Syne', sans-serif;
            font-size: 2.3rem;
            font-weight: 800;
            color: var(--primary-color);
            margin-bottom: 18px;
        }

        .project-description {
            color: #555;
            font-size: 1rem;
            line-height: 1.9;
            margin-bottom: 22px;
        }

        .section-title {
            font-family: 'Syne', sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--primary-color);
            margin: 45px 0 22px;
        }

        /* ================= HIGHLIGHT BOX ================= */
        .project-highlight {
            background: linear-gradient(135deg,
                    rgba(44, 49, 146, 0.05),
                    rgba(226, 180, 14, 0.08));
            border-radius: 18px;
            padding: 25px;
            margin: 35px 0;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            align-items: center;
        }

        .highlight-image {
            width: 100%;
            height: 50%;
            border-radius: 14px;
            object-fit: cover;
        }

        .highlight-content h3 {
            font-family: 'Syne', sans-serif;
            font-size: 1.45rem;
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 15px;
        }

        .highlight-list {
            list-style: none;
            padding: 0;
        }

        .highlight-list li {
            padding: 9px 0 9px 28px;
            position: relative;
            color: #555;
            font-size: 0.95rem;
        }

        .highlight-list li::before {
            content: "✔";
            position: absolute;
            left: 0;
            color: var(--accent-color);
            font-weight: bold;
        }

        /* ================= SIDEBAR ================= */
        .project-sidebar {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .sidebar-card {
            background: #ffffff;
            border-radius: 18px;
            padding: 30px 25px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.05);
        }

        .sidebar-card h3 {
            font-family: 'Syne', sans-serif;
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 22px;
        }

        /* ================= INFO ITEMS ================= */
        .info-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 14px 18px;
            border-radius: 30px;
            background: #f8f9fc;
            margin-top: 15px;
        }

        .info-icon {
            width: 46px;
            height: 46px;
            background: rgba(44, 49, 146, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary-color);
            font-size: 18px;
        }

        .info-content h4 {
            font-size: 0.75rem;
            color: #777;
            font-weight: 700;
            margin-bottom: 3px;
            text-transform: uppercase;
        }

        .info-content p {
            font-size: 1rem;
            color: var(--text-color);
            font-weight: 600;
        }

        /* ================= CONTACT ================= */
        .contact-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #555;
            font-size: 0.95rem;
        }

        .contact-item i {
            color: var(--accent-color);
        }

        /* ================= BUTTONS ================= */
        .brochure-button {
            width: 100%;
            background: var(--accent-color);
            color: #000;
            border: none;
            border-radius: 50px;
            padding: 15px 25px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .brochure-button:hover {
            background: #d4a800;
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(226, 180, 14, 0.4);
        }

        .company-profile-btn {
            background: transparent;
            color: var(--primary-color);
            border: 2px solid var(--primary-color);
        }

        .company-profile-btn:hover {
            background: var(--primary-color);
            color: #fff;
        }

        /* ================= RESPONSIVE ================= */
        @media (max-width: 968px) {
            .project-layout {
                grid-template-columns: 1fr;
            }

            .project-highlight {
                grid-template-columns: 1fr;
            }

            .highlight-image {
                height: 100%;
            }
        }

        @media (max-width: 480px) {
            .project-main {
                padding: 25px 18px;
            }
        }
    </style>


    <section class="page-hero">
        <div class="page-title">
            <div class="vertical-line"></div>
            <div class="page-text">
                <h1>Case Study Details</h1>
                <div class="breadcrumb">
                    <a href="/">Home</a>
                    <i class="fa-solid fa-angle-right"></i>
                    <span>Case Study Details</span>
                </div>
            </div>
        </div>
    </section>


    <div class="project-container">
        <div class="project-layout">
            <!-- Main Content -->
            <div class="project-main">
                <!-- Hero Image -->
                <img src="https://html.theme-village.com/transhub/demo/images/single-pt.jpg" alt="MKS Logistics Project"
                    class="project-hero-image">

                <!-- Project Header -->
                <div class="project-header">
                    <h1>MKS Logistics Project V.1</h1>
                    <p class="project-description">
                        Our Ocean Freight Services offer comprehensive solutions for all your shipping needs,
                        ensuring
                        your cargo is transported safely, cost-effectively, and timely. Whether you're shipping FCL
                        (Full Container Load) or LCL (Less than Container Load) cargo, or even heavy cargo, our
                        comprehensive services meet all aspects of your sea shipping needs.
                    </p>
                    <p class="project-description">
                        With our Ocean Freight Services, we handle all aspects of your sea shipping needs, from
                        documentation to delivery, ensuring smooth transit and competitive pricing. We navigate the
                        complexities of international trade regulations, making this seamless and efficient for you.
                    </p>
                </div>

                <!-- Project Details Section -->
                <h2 class="section-title">Project details</h2>
                <p class="project-description">
                    With our Ocean Freight Services, we handle all aspects of your sea shipping needs, from
                    documentation to delivery, ensuring smooth transit and competitive pricing. We navigate the
                    complexities of international trade regulations and offer business operational support digging
                    into
                    navigate the complexities of international trade.
                </p>

                <!-- Highlight Box -->
                <div class="project-highlight">
                    <img src="https://html.theme-village.com/transhub/demo/images/case-video.jpg"
                        alt="Project Highlight" class="highlight-image">
                    <div class="highlight-content">
                        <h3>Translog Around the World</h3>
                        <p style="color: var(--text-gray); margin-bottom: 15px; font-size: 0.95rem;">
                            Three core values define the spirit of our culture
                        </p>
                        <ul class="highlight-list">
                            <li>Ocean freight offers predictable transit times.</li>
                            <li>It embody one of the most economical.</li>
                            <li>Suitable for most, modern shipping services.</li>
                            <li>We are all about quality transport company.</li>
                        </ul>
                    </div>
                </div>

                <p class="project-description">
                    Freight forwarders often offer consolidated cargo services, where LCL cargo combines multiple
                    shipments from multiple companies into a full container. FCL (Full Container Load) is typically
                    used
                    when you have enough cargo to fill an entire container. It offers advantages similar to LCL but
                    without the consolidation process.
                </p>
                <p class="project-description">
                    This is a cost-effective option for smaller shipments. Your goods are consolidated with other
                    shippers, and you only pay for the space your cargo occupies. It can take longer as it involves
                    additional cost.
                </p>
            </div>

            <!-- Sidebar -->
            <div class="project-sidebar">
                <!-- Project Information -->
                <div class="sidebar-card">
                    <h3>Project Information</h3>
                    <div class="info-item">
                        <div class="info-icon">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="info-content">
                            <h4>Client</h4>
                            <p>Mark Anthonica</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-icon">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <div class="info-content">
                            <h4>Location</h4>
                            <p>Port au Mount Stanford</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-icon">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <div class="info-content">
                            <h4>Project Date</h4>
                            <p>January 22, 2025</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-icon">
                            <i class="fas fa-tag"></i>
                        </div>
                        <div class="info-content">
                            <h4>Category</h4>
                            <p>Sea Logistics</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-icon">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div class="info-content">
                            <h4>Duration</h4>
                            <p>45 Days, 300</p>
                        </div>
                    </div>
                </div>

                <!-- Contact Info -->
                <div class="sidebar-card">
                    <h3>Contact Info</h3>
                    <div class="contact-list">
                        <div class="contact-item">
                            <i class="fas fa-phone"></i>
                            <span>+33 (0)6 Anveal, Australia</span>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-envelope"></i>
                            <span>contact@gmhed.com</span>
                        </div>
                    </div>
                </div>

                <!-- Brochures -->
                <div class="sidebar-card">
                    <h3>Brochures</h3>
                    <button class="brochure-button">
                        <i class="fas fa-download"></i>
                        Download Brochure
                    </button>
                    <button class="brochure-button company-profile-btn">
                        <i class="fas fa-file-pdf"></i>
                        Company Profile
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Download button functionality
        document.querySelectorAll('.brochure-button').forEach(button => {
            button.addEventListener('click', function () {
                const buttonText = this.textContent.trim();
                console.log('Download clicked:', buttonText);
                // Add your download logic here
                alert(`Downloading ${buttonText}...`);
            });
        });

        // Smooth scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
