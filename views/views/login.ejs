<%- include('partials/header.ejs') %>
    <style>
        /* Login Section */
        .login-section {
            padding: 80px 0;
        }

        .login-section .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .login-box {
            background: white;
            padding: 50px 40px;
            border-radius: 20px;

        }

        .login-title {
            text-align: center;
            font-size: 28px;
            color: #1a1a2e;
            margin-bottom: 10px;
        }

        .login-subtitle {
            text-align: center;
            color: #666;
            margin-bottom: 40px;
            font-size: 14px;
        }

        .social-login {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
        }

        .social-btn {
            flex: 1;
            padding: 14px;
            border: 1px solid #e0e0e0;
            border-radius: 10px;
            background: white;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 18px;
        }

        .social-btn.facebook {
            background: #e2b40e;
            color: white;
            border-color: #e2b40e;
        }

        .social-btn.google {
            background: #1a2337;
            color: white;
            border-color: #1a2337;
        }

        .social-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }

        .divider {
            text-align: center;
            margin: 30px 0;
            position: relative;
        }

        .divider::before,
        .divider::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 45%;
            height: 1px;
            background: #e0e0e0;
        }

        .divider::before {
            left: 0;
        }

        .divider::after {
            right: 0;
        }

        .divider span {
            background: white;
            padding: 0 15px;
            color: #999;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #2c3192;
            font-weight: 500;
            font-size: 14px;
        }

        .form-group input {
            width: 100%;
            padding: 14px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            transition: border 0.3s;
        }

        .form-group input:focus {
            outline: none;
            border-color: #e2b40e;
        }

        .remember-forgot {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .remember-me {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
        }

        .remember-me input[type="checkbox"] {
            accent-color: #e2b40e;
        }

        .forgot-link {
            color: #e2b40e;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
        }

        .forgot-link:hover {
            text-decoration: underline;
        }

        .login-btn {
            width: 100%;
            background: #e2b40e;
            color: white;
            padding: 16px;
            border: none;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .login-btn:hover {
            background: #2c3192;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 87, 34, 0.4);
        }

        .Login-link {
            text-align: center;
            margin-top: 25px;
            font-size: 14px;
            color: #666;
        }

        .Login-link a {
            color: #e2b40e;
            text-decoration: none;
            font-weight: 600;
        }

        .Login-link a:hover {
            text-decoration: underline;
        }

        @media (max-width:768px) {
            .login-section .container {
                width: 100%;
                margin: 0 auto;
            }
        }

        @media (max-width: 640px) {
            .login-box {
                padding: 40px 25px;
            }

            .social-login {
                flex-direction: column;
            }
        }
    </style>
    </head>

    <body>
        <!-- Page Hero -->
        <section class="page-hero">
            <div class="page-title">
                <div class="vertical-line"></div>
                <div class="page-text">
                    <h1 class="tlt">Login</h1>
                    <div class="breadcrumb">
                        <a href="/">Home</a>
                        <i class="fa-solid fa-angle-right"></i>
                        <span>Login</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Login Section -->
        <section class="login-section">
            <div class="container">
                <div class="login-box">
                    <h2 class="login-title">Login To Your Account</h2>
                    <p class="login-subtitle">Please log-in access your account.</p>

                    <div class="social-login">
                        <button class="social-btn facebook">Login With Facebook</button>
                        <button class="social-btn google">Login With Google</button>
                    </div>

                    <div class="divider">
                        <span>OR</span>
                    </div>

                    <form>
                        <div class="form-group">
                            <label>Username*</label>
                            <input type="text" placeholder="Username" required>
                        </div>

                        <div class="form-group">
                            <label>Password*</label>
                            <input type="password" placeholder="Password" required>
                        </div>

                        <div class="remember-forgot">
                            <label class="remember-me">
                                <input type="checkbox">
                                <span>Remember me</span>
                            </label>
                            <a href="#" class="forgot-link">Forgot Password</a>
                        </div>

                        <button type="submit" class="login-btn">Login</button>

                        <p class="Login-link">
                            Don't have an account? <a href="/register">Register Now</a>
                        </p>
                    </form>
                </div>
            </div>
        </section>
    </body>

    <%- include('partials/footer.ejs') %>