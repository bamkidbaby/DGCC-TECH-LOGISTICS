<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FAQ + Appointment</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        :root {
            --bg-color: #fff;
            --text-color: #222;
            --primary-color: #2c3192;
            --accent-color: #e2b40e;
        }

        /* FAQ Section */
        .faq-section {
            padding: 80px 0;
            background: #fff;
        }

        .faq-section .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-label {
            color: var(--accent-color);
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 15px;
        }

        .section-title {
            font-size: 42px;
            color: #1a1a2e;
        }

        .faq-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
        }

        /* FAQ List */
        .faq-list {
            background: white;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, .08);
            backdrop-filter: blur(6px);
        }

        .faq-item {
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            margin-bottom: 15px;
            overflow: hidden;
            transition: all .3s ease;
            background: #fff;
        }

        .faq-item:hover {
            border-color: var(--accent-color);
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, .08);
        }

        .faq-item.active {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 2px rgba(255, 87, 34, .15);
        }

        .faq-question {
            padding: 20px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            font-weight: 600;
            color: #1a1a2e;
            font-size: 16px;
        }

        .faq-icon {
            color: var(--accent-color);
            font-size: 20px;
            transition: transform .35s ease;
        }

        .faq-answer {
            padding: 0 25px;
            max-height: 0;
            overflow: hidden;
            color: #666;
            line-height: 1.7;
            opacity: 0;
            transition: all .35s ease;
        }

        .faq-item.active .faq-answer {
            padding: 0 25px 20px;
            max-height: 220px;
            opacity: 1;
        }

        .faq-item.active .faq-icon {
            transform: rotate(45deg);
        }

        /* Appointment Form */
        .appointment-form {
            background: rgba(255, 255, 255, 0.92);
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, .08);
        }

        .form-title {
            font-size: 24px;
            color: #1a1a2e;
            margin-bottom: 30px;
            font-weight: 600;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .icon-input {
            position: relative;
        }

        .icon-input input,
        .icon-input select {
            width: 100%;
            padding: 14px 45px 14px 14px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            background: #fafafa;
            transition: all .3s;
        }

        .icon-input input:focus,
        .icon-input select:focus {
            outline: none;
            border-color: var(--accent-color);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(255, 87, 34, .15);
        }

        .input-icon {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #999;
        }

        .book-btn {
            width: 100%;
            background: var(--accent-color);
            color: white;
            padding: 16px;
            border: none;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all .3s;
        }

        .book-btn:hover {
            background: var(--primary-color);
            transform: translateY(-2px);
        }

        @media (max-width: 968px) {
            .faq-layout {
                grid-template-columns: 1fr;
            }

            .faq-section .container {
                max-width: 100%;
                margin: 0 auto;
            }


            .section-title {
                font-size: 25px;
            }
        }
    </style>
</head>

<body>

    <section class="faq-section">
        <div class="container">

            <div class="section-header">
                <div class="section-label">OUR EXPERT TEAM MEMBERS</div>
                <h2 class="section-title">What Details Are Required<br>for a Quote?</h2>
            </div>

            <div class="faq-layout">

                <!-- FAQ -->
                <div class="faq-list">

                    <div class="faq-item active">
                        <div class="faq-question">
                            How can I track my shipment?
                            <span class="faq-icon">+</span>
                        </div>
                        <div class="faq-answer">
                            Track your shipment using your Tracking ID in our real-time tracking tool.
                        </div>
                    </div>

                    <div class="faq-item">
                        <div class="faq-question">
                            How do I contact support?
                            <span class="faq-icon">+</span>
                        </div>
                        <div class="faq-answer">
                            Reach us via phone, email or live chat — 24/7 available.
                        </div>
                    </div>

                    <div class="faq-item">
                        <div class="faq-question">
                            What if shipment is delayed?
                            <span class="faq-icon">+</span>
                        </div>
                        <div class="faq-answer">
                            Our team will immediately investigate and resolve the issue.
                        </div>
                    </div>

                    <div class="faq-item">
                        <div class="faq-question">
                            Can I schedule shipments?
                            <span class="faq-icon">+</span>
                        </div>
                        <div class="faq-answer">
                            Yes! We offer custom recurring shipment plans.
                        </div>
                    </div>

                    <div class="faq-item">
                        <div class="faq-question">
                            How is pricing calculated?
                            <span class="faq-icon">+</span>
                        </div>
                        <div class="faq-answer">
                            Based on weight, size, destination & delivery speed.
                        </div>
                    </div>

                </div>

                <!-- FORM -->
                <div class="appointment-form">
                    <h3 class="form-title">Make An Appointment</h3>

                    <form>
                        <div class="form-group">
                            <div class="icon-input">
                                <input type="text" placeholder="Your name">
                                <span class="input-icon"><i class="fa-solid fa-user"></i></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="icon-input">
                                <input type="email" placeholder="Your email">
                                <span class="input-icon"><i class="fa-solid fa-envelope"></i></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="icon-input">
                                <input type="tel" placeholder="Phone Number">
                                <span class="input-icon"><i class="fa-solid fa-phone"></i></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="icon-input">
                                <select>
                                    <option>Freight City</option>
                                    <option>New York</option>
                                    <option>Los Angeles</option>
                                    <option>Chicago</option>
                                </select>
                                <span class="input-icon"><i class="fa-solid fa-location-dot"></i></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="icon-input">
                                <input type="text" placeholder="Travel Unit">
                                <span class="input-icon"><i class="fa-solid fa-calendar"></i></span>
                            </div>
                        </div>

                        <button class="book-btn">Book An Appointment <i class="fas fa-arrow-right"></i></button>
                    </form>
                </div>

            </div>
        </div>
    </section>

    <script>
        const faqItems = document.querySelectorAll('.faq-item');

        faqItems.forEach(item => {
            const question = item.querySelector('.faq-question');

            question.addEventListener('click', () => {

                faqItems.forEach(other => {
                    if (other !== item) other.classList.remove('active');
                });

                item.classList.toggle('active');

            });
        });
    </script>

</body>

</html>