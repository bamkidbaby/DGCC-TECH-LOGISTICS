<!-- Scroll to Top Button -->
<button class="scroll-to-top" id="scrollToTop">
    <svg class="progress-ring" width="50" height="50">
        <circle class="progress-ring__circle" stroke-dasharray="144" stroke-dashoffset="144" cx="25" cy="25" r="23">
        </circle>
    </svg>
    <span class="scroll-arrow"><i class="fas fa-angle-up"></i></span>
</button>


<script src="script/script.js"></script>
<script src="script/scrollToTop.js"></script>
<script src="script/service-section.js"></script>
<script src="script/mobile-menu.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"
    integrity="sha256-+b3S4bUuQJ4vn3kEfl0sxP6uJ7L5a6Fhj7UVq1mx2/Y=" crossorigin="anonymous"></script>
<!-- AOS Animate On Scroll -->
<link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">
<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>

<!-- PureCounter -->
<script src="https://cdn.jsdelivr.net/npm/@srexi/purecounterjs/dist/purecounter_vanilla.js"></script>
<!-- Font Awesome (for icons) -->
<script src="https://kit.fontawesome.com/your-kit-id.js" crossorigin="anonymous"></script>

<script>
    // Initialize AOS
    AOS.init({
        duration: 1000,
        easing: "ease-out-cubic",
        once: true,
        offset: 120
    });


    // Scroll to Top Button with Progress Indicator
    const scrollToTopBtn = document.getElementById('scrollToTop');
    const progressCircle = document.querySelector('.progress-ring__circle');
    const circumference = 144; // 2 * Math.PI * 23 (radius)

    window.addEventListener('scroll', () => {
        const scrollTotal = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrollProgress = (window.pageYOffset / scrollTotal) * circumference;

        // Update progress circle
        progressCircle.style.strokeDashoffset = circumference - scrollProgress;

        // Show/hide button
        if (window.pageYOffset > 300) {
            scrollToTopBtn.classList.add('visible');
        } else {
            scrollToTopBtn.classList.remove('visible');
        }
    });

    scrollToTopBtn.addEventListener('click', () => {
        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
    });
    new PureCounter();
</script>
