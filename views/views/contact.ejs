<%- include('partials/header.ejs') %>
    <section class="page-hero">
        <div class="page-title">
            <div class="vertical-line"></div>
            <div class="page-text">
                <h1>Contact Us</h1>
                <div class="breadcrumb">
                    <a href="/">Home</a>
                    <i class="fas fa-angle-right"></i>
                    <span>Contact Us</span>
                </div>
            </div>
        </div>
    </section>
    <style>
        :root {
            --bg-color: #fff;
            --text-color: #222;
            --primary-color: #2c3192;
            --accent-color: #e2b40e;
        }

        /* Contact Info Section */
        .contact-info-section {
            padding: 50px 0;
            background: #ecf0f1;
        }

        .contact-info-section .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .contact-info {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .section-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-label {
            color: var(--primary-color);
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 15px;
        }

        .section-title {
            font-size: 42px;
            color: #1a1a2e;
        }

        .contact-cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
            margin-bottom: 60px;
        }

        .contact-card {
            display: flex;
            gap: 15px;
            align-items: flex-start;
            background: white;
            padding: 25px 10px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
            transition: transform 0.3s;
        }

        .contact-card:hover {
            transform: translateY(-10px);
        }

        .contact-icon {
            width: 80px;
            height: 80px;
            background: #fff5f2;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            color: #ccc5c3;
        }

        .contact-card h3 {
            font-size: 20px;
            color: #1a1a2e;
        }

        .contact-detail {
            color: #666;
            font-size: 15px;
            line-height: 1.6;
        }

        .view-link {
            color: #111;
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .view-link:hover {
            text-decoration: underline;
        }

        .contact-info .social-links {
            display: flex;
            flex-direction: column;
            text-align: center;

        }

        .contact-info .social-title {
            font-size: 14px;
            color: #666;
            margin-bottom: 15px;
        }

        .contact-info .social-icons {
            display: flex;
            justify-content: center;
            gap: 15px;
        }

        .contact-info .social-icon {
            width: 40px;
            height: 40px;
            background: var(--accent-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            cursor: pointer;
            transition: all 0.3s;
        }

        .social-icon:hover {
            background: var(--primary-color);
            transform: translateY(-3px);
        }

        /* Location Tabs */
        .location {
            padding: 80px 20px;
            background: var(--bg-color);
        }

        /* ===== TABS AREA ===== */

        .location-tabs-section {
            text-align: center;
            margin-bottom: 50px;
        }

        .location-title {
            font-size: 32px;
            font-weight: 700;
            color: var(--text-color);
            margin-bottom: 25px;
        }

        .location-tabs {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .location-tab {
            padding: 14px 32px;
            border-radius: 40px;
            border: 2px solid var(--primary-color);
            background: transparent;
            color: var(--primary-color);
            font-weight: 600;
            cursor: pointer;
            transition: all .35s ease;
            position: relative;
            overflow: hidden;
        }

        .location-tab.active,
        .location-tab:hover {
            background: var(--primary-color);
            color: white;
            box-shadow: 0 10px 25px rgba(44, 49, 146, .35);
        }

        /* ===== CONTENT GRID ===== */

        .contact-form-section {
            max-width: 1200px;
            margin: auto;
            display: grid;
            grid-template-columns: 1.3fr 1fr;
            gap: 50px;
            align-items: stretch;
        }

        /* ===== MAP ===== */

        .map-container {
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0, 0, 0, .15);
        }

        /* ===== FORM ===== */
        .form-bg {
            background: url("https://html.theme-village.com/transhub/demo/images/form-bg2.jpg");
            border-radius: 25px;
        }

        .contact-form-box {
            background: rgba(5, 6, 17, 0.562);
            border: 1px solid rgba(226, 180, 14, 0.3);
            backdrop-filter: 25px;
            padding: 45px 25px;
            border-radius: 25px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, .08);
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 15px 18px;
            border-radius: 30px;
            border: 1.5px solid #ddd;
            font-size: 14px;
            transition: .3s;
        }

        .form-group textarea {
            min-height: 130px;
            resize: none;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(44, 49, 146, .12);
        }

        .submit-btn {
            width: 100%;
            padding: 16px;
            border-radius: 40px;
            border: none;
            background: linear-gradient(135deg,
                    var(--primary-color),
                    var(--accent-color));
            color: white;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: .3s;
        }

        .submit-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(44, 49, 146, .4);
        }

        .submit-btn i {
            margin-left: 8px;
        }


        @media (max-width: 1024px) {
            .contact-cards {
                grid-template-columns: 1fr;
            }

            .contact-form-section {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <!-- Contact Info Section -->
    <section class="contact-info-section">
        <div class="container">
            <div class="contact-info">
                <div class="section-header">
                    <div class="section-label"><i class="fas fa-phone"></i> CONTACT US</div>
                    <h2 class="section-title">Start Your Journey with Us</h2>
                </div>

                <div class="contact-cards">
                    <!-- Phone Card -->
                    <div class="contact-card">
                        <div class="contact-icon"><i class="fas fa-phone"></i></div>
                        <div class="right-side">
                            <h3>Phone</h3>
                            <p class="contact-detail">+65 21 226 276</p>
                            <p class="contact-detail">Email: transhub@gmail.com</p>
                            <a href="#" class="view-link">SEND EMAIL <i class="fas fa-angles-right"></i></a>
                        </div>
                    </div>

                    <!-- Email Card -->
                    <div class="contact-card">
                        <div class="contact-icon"><i class="fas fa-clock"></i></div>
                        <div class="right-side">
                            <h3>Mon-Sat</h3>
                            <p class="contact-detail">8:00AM (on US 10:00 pm)</p>
                            <p class="contact-detail">Saturday / Closed</p>
                            <a href="#" class="view-link">SEND AN APPOINTMENT <i class="fas fa-angles-right"></i></a>
                        </div>
                    </div>

                    <!-- Address Card -->
                    <div class="contact-card">
                        <div class="contact-icon"><i class="fas fa-location-dot"></i></div>

                        <div class="right-side">
                            <h3>Address</h3>
                            <p class="contact-detail">165 Station Office at Riaz,</p>
                            <p class="contact-detail">42 State, USA</p>
                            <a href="#" class="view-link">VIEW JOEAP <i class="fas fa-angles-right"></i> </a>
                        </div>
                    </div>
                </div>
                <div class="social-links">
                    <p class="social-title">Social Connect:</p>
                    <div class="social-icons">
                        <div class="social-icon"><i class="fab fa-facebook-f"></i></div>
                        <div class="social-icon"><i class="fab fa-x-twitter"></i></div>
                        <div class="social-icon"><i class="fab fa-linkedin-in"></i></div>
                        <div class="social-icon"><i class="fab fa-instagram"></i></div>
                    </div>
                </div>
            </div>
    </section>


    <section class="location">
        <!-- Location Tabs -->
        <div class="location-tabs-section">
            <h3 class="location-title">Reach out anytime for help!</h3>
            <div class="location-tabs">
                <button class="location-tab">Hong Kong</button>
                <button class="location-tab">Singapore</button>
                <button class="location-tab">Switzerland</button>
                <button class="location-tab active">New York City</button>
            </div>
        </div>

        <!-- Contact Form and Map -->
        <div class="contact-form-section">
            <div class="map-container">
                <iframe id="mapFrame"
                    src="https://maps.google.com/maps?q=New%20York&t=&z=12&ie=UTF8&iwloc=&output=embed" width="100%"
                    height="100%" style="border:0;" loading="lazy">
                </iframe>
            </div>

            <div class="form-bg">


                <div class="contact-form-box">
                    <form>
                        <div class="form-group">
                            <input type="text" placeholder="Your name">
                        </div>

                        <div class="form-group">
                            <input type="email" placeholder="Your email">
                        </div>

                        <div class="form-group">
                            <input type="tel" placeholder="Phone no">
                        </div>

                        <div class="form-group">
                            <input type="text" placeholder="Leave">
                        </div>

                        <div class="form-group">
                            <textarea placeholder="Message"></textarea>
                        </div>

                        <button type="submit" class="submit-btn">Submit Request <i
                                class="fas fa-arrow-right"></i></button>
                    </form>
                </div>
            </div>
        </div>
        </div>
        </div>
    </section>

    <script>
        const tabs = document.querySelectorAll('.location-tab');
        const maps = {
            "Hong Kong": "https://maps.google.com/maps?q=Hong%20Kong&t=&z=12&output=embed",
            "Singapore": "https://maps.google.com/maps?q=Singapore&t=&z=12&output=embed",
            "Switzerland": "https://maps.google.com/maps?q=Switzerland&t=&z=7&output=embed",
            "New York City": "https://maps.google.com/maps?q=New%20York&t=&z=12&output=embed"
        };
        const map = document.getElementById("mapFrame")


        tabs.forEach(tab => {
            tab.addEventListener("click", () => {
                tabs.forEach(t => t.classList.remove("active"));
                tab.classList.add("active");
                map.src = maps[tab.innerText];
            });
        });
    </script>
    <%- include('partials/footer.ejs') %>