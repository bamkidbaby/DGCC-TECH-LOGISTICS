    <script>
        // Quantity controls
        document.querySelectorAll('.qty-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const qtyDisplay = this.parentElement.querySelector('.qty-display');
                let value = parseInt(qtyDisplay.value);
                if (this.textContent === '+') {
                    qtyDisplay.value = value + 1;
                } else if (value > 1) {
                    qtyDisplay.value = value - 1;
                }

                // Update total price
                updateItemTotal(this.closest('tr'));
            });
        });

        // Remove buttons
        document.querySelectorAll('.remove-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                if (confirm('Are you sure you want to remove this item?')) {
                    this.closest('tr').style.opacity = '0';
                    this.closest('tr').style.transform = 'translateX(-20px)';
                    setTimeout(() => {
                        this.closest('tr').remove();
                    }, 300);
                }
            });
        });

        // Update item total (placeholder function - you can expand this)
        function updateItemTotal(row) {
            // This is a placeholder - you would calculate actual totals here
            console.log('Updating totals...');
        }

        // Add smooth transitions
        document.querySelectorAll('.cart-table tr').forEach(row => {
            row.style.transition = 'all 0.3s ease';
        });
    </script>

