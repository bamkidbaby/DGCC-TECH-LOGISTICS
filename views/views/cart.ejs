<%- include('partials/header.ejs') %>

    <style>
        :root {
            --bg-color: #fff;
            --text-color: #222;
            --primary-color: #2c3192;
            --accent-color: #e2b40e;
        }

        /* Cart Section */
        .cart-section {
            padding: 60px 20px;
            background: var(--bg-color);
            color: var(--text-color);
        }

        .cart-section .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .cart-layout {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 30px;
        }

        /* Cart Table */
        .cart-table-container {
            background: var(--bg-color);
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        }

        .cart-table {
            width: 100%;
            border-collapse: collapse;
        }

        .cart-table thead {
            background: #f8f9fa;
        }

        .cart-table th {
            padding: 15px;
            text-align: left;
            font-weight: 600;
            color: var(--primary-color);
            border-bottom: 2px solid #e0e0e0;
        }

        .cart-table td {
            padding: 20px 15px;
            border-bottom: 1px solid #f0f0f0;
            vertical-align: middle;
        }

        .product-cell {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .product-image {
            width: 80px;
            height: 80px;
            border-radius: 8px;
            object-fit: cover;
            flex-shrink: 0;
        }

        .product-name {
            font-weight: 600;
            color: var(--text-color);
            font-size: 15px;
        }

        .product-price {
            font-size: 18px;
            color: var(--text-color);
            font-weight: 600;
        }

        .quantity-control {
            display: flex;
            align-items: center;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            overflow: hidden;
            width: fit-content;
        }

        .qty-btn {
            width: 35px;
            height: 35px;
            border: none;
            background: #f5f5f5;
            cursor: pointer;
            font-size: 16px;
            transition: background 0.3s;
        }

        .qty-btn:hover {
            background: var(--accent-color);
            color: #fff;
        }

        .qty-display {
            width: 40px;
            text-align: center;
            border: none;
            font-weight: 600;
            background: transparent;
        }

        .remove-btn {
            background: #ff4444;
            color: white;
            border: none;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 18px;
            transition: all 0.3s;
        }

        .remove-btn:hover {
            background: #cc0000;
            transform: scale(1.1);
        }

        /* Cart Actions */
        .cart-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #e0e0e0;
            flex-wrap: wrap;
            gap: 15px;
        }

        .coupon-section {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            flex: 1;
            min-width: 280px;
        }

        .coupon-input {
            padding: 12px 20px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            flex: 1;
            min-width: 180px;
        }

        .apply-btn {
            background: var(--primary-color);
            color: white;
            padding: 12px 25px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.3s;
            white-space: nowrap;
        }

        .apply-btn:hover {
            background: var(--accent-color);
        }

        .continue-btn {
            background: var(--accent-color);
            color: white;
            padding: 12px 30px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            white-space: nowrap;
        }

        .continue-btn:hover {
            background: #d19c07;
        }

        /* Cart Summary */
        .cart-summary {
            background: var(--bg-color);
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
            height: fit-content;
            position: sticky;
            top: 100px;
        }

        .summary-title {
            font-size: 20px;
            color: var(--primary-color);
            margin-bottom: 20px;
            font-weight: 600;
        }

        .summary-item {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #f0f0f0;
        }

        .summary-label {
            color: #666;
            font-size: 14px;
        }

        .summary-value {
            color: var(--text-color);
            font-weight: 600;
        }

        .summary-total {
            padding: 20px 0;
            font-size: 20px;
            font-weight: 700;
            color: var(--text-color);
        }

        .summary-total .summary-value {
            color: var(--accent-color);
        }

        .checkout-btn {
            width: 100%;
            background: var(--accent-color);
            color: white;
            padding: 15px;
            border: none;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 20px;
        }

        .checkout-btn:hover {
            background: #d19c07;
            transform: translateY(-2px);
        }

        /* Tablet Screens (768px - 1024px) */
        @media (max-width: 1024px) {
            .cart-section {
                padding: 40px 15px;
            }

            .cart-layout {
                grid-template-columns: 1fr;
                gap: 25px;
            }

            .cart-summary {
                position: static;
                margin-top: 0;
            }

            .cart-table th,
            .cart-table td {
                padding: 12px 10px;
            }

            .product-image {
                width: 70px;
                height: 70px;
            }

            .product-name {
                font-size: 14px;
            }

            .product-price {
                font-size: 16px;
            }
        }

        /* Mobile Large (481px - 768px) */
        @media (max-width: 768px) {
            .cart-section {
                padding: 30px 10px;
            }

            .cart-table-container {
                padding: 20px 15px;
                overflow-x: auto;
            }

            .cart-table {
                min-width: 600px;
            }

            .cart-table th,
            .cart-table td {
                padding: 10px 8px;
                font-size: 13px;
            }

            .product-cell {
                gap: 10px;
            }

            .product-image {
                width: 60px;
                height: 60px;
            }

            .product-name {
                font-size: 13px;
            }

            .product-price {
                font-size: 15px;
            }

            .qty-btn {
                width: 30px;
                height: 30px;
                font-size: 14px;
            }

            .qty-display {
                width: 35px;
            }

            .remove-btn {
                width: 30px;
                height: 30px;
                font-size: 16px;
            }

            .cart-actions {
                flex-direction: column;
                gap: 12px;
            }

            .coupon-section {
                width: 100%;
                min-width: auto;
            }

            .coupon-input,
            .apply-btn,
            .continue-btn {
                width: 100%;
            }

            .cart-summary {
                padding: 25px 20px;
            }

            .summary-title {
                font-size: 18px;
            }
        }

        /* Mobile Small (320px - 480px) */
        @media (max-width: 480px) {
            .cart-section {
                padding: 20px 5px;
            }

            .cart-table-container {
                padding: 15px 10px;
                border-radius: 10px;
                box-shadow: 0 3px 15px rgba(0, 0, 0, 0.06);
            }

            /* Mobile Card Layout */
            .cart-table {
                min-width: auto;
            }

            .cart-table thead {
                display: none;
            }

            .cart-table tbody {
                display: block;
            }

            .cart-table tr {
                display: block;
                margin-bottom: 20px;
                padding: 15px;
                border: 1px solid #e0e0e0;
                border-radius: 10px;
                background: #fafafa;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
            }

            .cart-table td {
                display: block;
                padding: 8px 0;
                border: none;
                text-align: left;
            }

            .cart-table td::before {
                content: attr(data-label);
                font-weight: 600;
                color: var(--primary-color);
                display: block;
                margin-bottom: 5px;
                font-size: 12px;
                text-transform: uppercase;
            }

            .product-cell {
                flex-direction: row;
                align-items: center;
                gap: 12px;
                margin-bottom: 10px;
            }

            .product-image {
                width: 80px;
                height: 80px;
            }

            .product-name {
                font-size: 14px;
                flex: 1;
            }

            .product-price {
                font-size: 16px;
                display: inline-block;
            }

            .quantity-control {
                margin: 10px 0;
            }

            .remove-btn {
                margin-top: 10px;
                width: 100%;
                border-radius: 8px;
                height: 40px;
            }

            .cart-actions {
                padding-top: 15px;
            }

            .coupon-input {
                font-size: 13px;
                padding: 10px 15px;
            }

            .apply-btn,
            .continue-btn {
                font-size: 14px;
                padding: 10px 20px;
            }

            .cart-summary {
                padding: 20px 15px;
                border-radius: 10px;
            }

            .summary-title {
                font-size: 17px;
            }

            .summary-item {
                padding: 10px 0;
                font-size: 13px;
            }

            .summary-total {
                font-size: 18px;
                padding: 15px 0;
            }

            .checkout-btn {
                padding: 12px;
                font-size: 15px;
                border-radius: 25px;
            }
        }

        /* Extra Small Mobile (max 360px) */
        @media (max-width: 360px) {
            .cart-section {
                padding: 15px 5px;
            }

            .cart-table-container {
                padding: 12px 8px;
            }

            .cart-table tr {
                padding: 12px;
                margin-bottom: 15px;
            }

            .product-image {
                width: 70px;
                height: 70px;
            }

            .product-name {
                font-size: 13px;
            }

            .product-price {
                font-size: 15px;
            }

            .qty-btn {
                width: 28px;
                height: 28px;
                font-size: 13px;
            }

            .qty-display {
                width: 30px;
                font-size: 13px;
            }

            .cart-summary {
                padding: 18px 12px;
            }

            .summary-title {
                font-size: 16px;
            }

            .summary-item {
                font-size: 12px;
            }

            .summary-total {
                font-size: 17px;
            }

            .checkout-btn {
                font-size: 14px;
            }
        }

        /* Landscape Mobile */
        @media (max-height: 500px) and (orientation: landscape) {
            .cart-section {
                padding: 20px 15px;
            }

            .cart-summary {
                position: static;
            }
        }
    </style>

