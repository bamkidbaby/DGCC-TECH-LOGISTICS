<%- include('partials/header.ejs') %>

    <section class="page-hero">
        <div class="page-title">
            <div class="vertical-line"></div>
            <div class="page-text">
                <h1>Blog Classic</h1>
                <div class="breadcrumb">
                    <a href="/">Home</a>
                    <i class="fa-solid fa-angle-right"></i>
                    <span>Blog Classic</span>
                </div>
            </div>
        </div>
    </section>

    <style>
        /* LAYOUT */
        .blog-layout {
            max-width: 1200px;
            margin: 80px auto;
            padding: 0 20px;
            display: grid;
            grid-template-columns: 1fr 350px;
            gap: 40px;
        }

        /* SEARCH */
        .blog-search-form {
            display: flex;
            background: #fff;
            border-radius: 50px;
            overflow: hidden;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .08);
            margin-bottom: 30px;
        }

        .blog-search-input {
            flex: 1;
            padding: 14px 20px;
            border: none;
            outline: none;
            font-size: 14px;
        }

        .blog-search-input::placeholder {
            color: #999;
        }

        .blog-search-button {
            width: 55px;
            background: var(--accent-orange);
            color: #fff;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .blog-search-button:hover {
            background: #e64a19;
        }

        /* POSTS */
        .blog-posts {
            display: grid;
            grid-template-rows: 2fr 2fr 2fr;
            gap: 35px;
        }

        .blog-card {
            background: #fff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 6px 18px rgba(0, 0, 0, .08);
            transition: all 0.4s ease;
            display: flex;
            flex-direction: column;
        }

        .blog-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, .12);
        }

        .blog-image-container {
            position: relative;
            overflow: hidden;
        }

        .blog-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .blog-card:hover .blog-image {
            transform: scale(1.08);
        }

        /* TAGS */
        .blog-tags {
            position: absolute;
            top: 15px;
            left: 15px;
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            z-index: 2;
        }

        .blog-tag {
            background: var(--accent-orange);
            color: #fff;
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(255, 87, 34, 0.3);
        }

        /* CONTENT */
        .blog-content {
            padding: 25px;
        }

        .blog-title {
            font-family: 'Syne', sans-serif;
            font-size: 1.4rem;
            margin-bottom: 12px;
            color: var(--primary-navy, #0a1929);
            line-height: 1.3;
            transition: color 0.3s ease;
        }

        .blog-card:hover .blog-title {
            color: var(--accent-orange);
        }

        .blog-excerpt {
            color: var(--text-gray, #666);
            line-height: 1.7;
            margin-bottom: 18px;
            font-size: 1rem;
        }

        .blog-read-more {
            display: inline-flex;
            width: 20%;
            align-items: center;
            gap: 8px;
            background: #e2b40e;
            color: #fff;
            padding: 12px 26px;
            border-radius: 40px;
            font-weight: 600;
            text-decoration: none;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .blog-read-more:hover {
            background: #2c3192;
            gap: 12px;
        }

        /* SIDEBAR */
        .blog-sidebar-widget {
            background: #fff;
            padding: 25px;
            border-radius: 18px;
            margin-bottom: 25px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, .08);
        }

        .blog-widget-title {
            font-family: 'Syne', sans-serif;
            font-size: 1.2rem;
            margin-bottom: 20px;
            color: var(--primary-navy, #0a1929);
            font-weight: 700;
        }

        /* CATEGORY */
        .blog-category-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #eee;
            text-decoration: none;
            color: #333;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .blog-category-item:last-child {
            border-bottom: none;
        }

        .blog-category-item:hover {
            color: var(--accent-orange);
            padding-left: 8px;
        }

        .blog-category-item span:last-child {
            background: #f5f5f5;
            padding: 3px 10px;
            border-radius: 15px;
            font-size: 12px;
            font-weight: 600;
            color: #666;
        }

        /* RECENT POSTS */
        .blog-recent-post {
            display: flex;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid #eee;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .blog-recent-post:last-child {
            border-bottom: none;
        }

        .blog-recent-post:hover {
            transform: translateX(5px);
        }

        .blog-recent-image {
            width: 65px;
            height: 65px;
            border-radius: 12px;
            object-fit: cover;
            flex-shrink: 0;
        }

        .blog-recent-post h4 {
            font-family: 'Syne', sans-serif;
            font-size: 0.95rem;
            font-weight: 600;
            margin-bottom: 4px;
            line-height: 1.3;
            color: #333;
        }

        .blog-recent-post:hover h4 {
            color: var(--accent-orange);
        }

        .blog-recent-post small {
            font-size: 0.8rem;
            color: #999;
        }

        /* KEYWORDS */
        .blog-keywords {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .blog-keyword-tag {
            background: #f3f3f3;
            padding: 8px 16px;
            border-radius: 30px;
            font-size: 13px;
            text-decoration: none;
            color: #333;
            font-weight: 500;
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

        .blog-keyword-tag:hover {
            background: #2c3192;
            color: #fff;
            border-color: #e2b40e;
            transform: translateY(-2px);
        }

        /* PAGINATION */
        .pagination {
            grid-column: 1/-1;
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 60px;
            flex-wrap: wrap;
        }

        .page-btn {
            width: 46px;
            height: 46px;
            border: 1px solid #ddd;
            background: #fff;
            color: #111;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 14px;
        }

        .page-btn.active,
        .page-btn:hover {
            background: #2c3192;
            color: #fff;

            transform: translateY(-2px);
        }

        /* TABLET (768px - 1024px) */
        @media (max-width: 1024px) {
            .blog-layout {
                max-width: 100%;
                margin: 60px auto;
                padding: 0 20px;
                gap: 35px;
            }

            .blog-image-container {
                height: 280px;
            }

            .blog-content {
                padding: 22px;
            }

            .blog-title {
                font-size: 1.3rem;
            }
        }

        /* MOBILE LANDSCAPE & SMALL TABLET (600px - 900px) */
        @media (max-width: 900px) {
            .blog-layout {
                grid-template-columns: 1fr;
                margin: 50px auto;
                gap: 30px;
            }

            .blog-posts {
                gap: 30px;
            }

            .blog-image-container {
                height: 260px;
            }

            .blog-sidebar-widget {
                padding: 22px 20px;
            }

            .pagination {
                margin-top: 50px;
            }
        }

        /* MOBILE LARGE (481px - 768px) */
        @media (max-width: 768px) {
            .blog-layout {
                margin: 40px auto;
                padding: 0 15px;
            }

            .blog-posts {
                gap: 25px;
            }

            .blog-card {
                border-radius: 16px;
            }

            .blog-image-container {
                height: 220px;
            }

            .blog-content {
                padding: 20px 18px;
            }

            .blog-title {
                font-size: 1.2rem;
                margin-bottom: 10px;
            }

            .blog-excerpt {
                font-size: 0.95rem;
                margin-bottom: 15px;
            }

            .blog-read-more {
                padding: 10px 22px;
                font-size: 13px;
                width: 35%;
            }

            .blog-search-form {
                margin-bottom: 25px;
            }

            .blog-search-input {
                padding: 12px 18px;
                font-size: 13px;
            }

            .blog-search-button {
                width: 50px;
            }

            .blog-sidebar-widget {
                padding: 20px 18px;
                border-radius: 15px;
                margin-bottom: 22px;
            }

            .blog-widget-title {
                font-size: 1.1rem;
                margin-bottom: 18px;
            }

            .blog-category-item {
                padding: 11px 0;
                font-size: 0.95rem;
            }

            .blog-recent-image {
                width: 60px;
                height: 60px;
            }

            .blog-recent-post h4 {
                font-size: 0.9rem;
            }

            .blog-keyword-tag {
                padding: 7px 14px;
                font-size: 12px;
            }

            .page-btn {
                width: 42px;
                height: 42px;
                font-size: 13px;
            }

            .pagination {
                gap: 10px;
                margin-top: 40px;
            }
        }

        /* MOBILE MEDIUM (376px - 480px) */
        @media (max-width: 480px) {
            .blog-layout {
                margin: 30px auto;
                padding: 0 12px;
            }

            .blog-posts {
                gap: 22px;
            }

            .blog-card {
                border-radius: 14px;
            }

            .blog-image-container {
                height: 200px;
            }

            .blog-tags {
                top: 12px;
                left: 12px;
                gap: 6px;
            }

            .blog-tag {
                padding: 5px 12px;
                font-size: 11px;
            }

            .blog-content {
                padding: 18px 15px;
            }

            .blog-title {
                font-size: 1.1rem;
            }

            .blog-excerpt {
                font-size: 0.9rem;
                line-height: 1.6;
            }

            .blog-read-more {
                padding: 9px 20px;
                font-size: 12px;
            }

            .blog-search-form {
                margin-bottom: 20px;
            }

            .blog-search-input {
                padding: 11px 16px;
                font-size: 12px;
            }

            .blog-search-button {
                width: 48px;
                font-size: 13px;
            }

            .blog-sidebar-widget {
                padding: 18px 15px;
                margin-bottom: 20px;
            }

            .blog-widget-title {
                font-size: 1.05rem;
                margin-bottom: 16px;
            }

            .blog-category-item {
                padding: 10px 0;
                font-size: 0.9rem;
            }

            .blog-category-item span:last-child {
                font-size: 11px;
                padding: 2px 8px;
            }

            .blog-recent-post {
                padding: 10px 0;
                gap: 10px;
            }

            .blog-recent-image {
                width: 55px;
                height: 55px;
                border-radius: 10px;
            }

            .blog-recent-post h4 {
                font-size: 0.85rem;
            }

            .blog-recent-post small {
                font-size: 0.75rem;
            }

            .blog-keywords {
                gap: 8px;
            }

            .blog-keyword-tag {
                padding: 6px 12px;
                font-size: 11px;
            }

            .page-btn {
                width: 40px;
                height: 40px;
                font-size: 12px;
            }

            .pagination {
                gap: 8px;
                margin-top: 35px;
            }
        }

        /* MOBILE SMALL (max 375px) */
        @media (max-width: 375px) {
            .blog-layout {
                padding: 0 10px;
                margin: 25px auto;
            }

            .blog-posts {
                gap: 20px;
            }

            .blog-image-container {
                height: 180px;
            }

            .blog-tags {
                top: 10px;
                left: 10px;
            }

            .blog-tag {
                padding: 4px 10px;
                font-size: 10px;
            }

            .blog-content {
                padding: 15px 12px;
            }

            .blog-title {
                font-size: 1rem;
            }

            .blog-excerpt {
                font-size: 0.85rem;
            }

            .blog-read-more {
                padding: 8px 18px;
                font-size: 11px;
            }

            .blog-sidebar-widget {
                padding: 16px 12px;
            }

            .blog-widget-title {
                font-size: 1rem;
            }

            .blog-category-item {
                font-size: 0.85rem;
            }

            .blog-recent-image {
                width: 50px;
                height: 50px;
            }

            .blog-recent-post h4 {
                font-size: 0.8rem;
            }

            .blog-keyword-tag {
                padding: 5px 10px;
                font-size: 10px;
            }

            .page-btn {
                width: 38px;
                height: 38px;
                font-size: 11px;
            }

            .pagination {
                gap: 6px;
            }
        }

        /* EXTRA SMALL (max 320px) */
        @media (max-width: 320px) {
            .blog-layout {
                padding: 0 8px;
            }

            .blog-image-container {
                height: 160px;
            }

            .blog-content {
                padding: 12px 10px;
            }

            .blog-title {
                font-size: 0.95rem;
            }

            .blog-sidebar-widget {
                padding: 14px 10px;
            }

            .blog-recent-image {
                width: 45px;
                height: 45px;
            }

            .page-btn {
                width: 36px;
                height: 36px;
            }
        }

        /* LANDSCAPE MODE OPTIMIZATION */
        @media (max-height: 500px) and (orientation: landscape) {
            .blog-layout {
                margin: 30px auto;
            }

            .blog-image-container {
                height: 200px;
            }

            .blog-posts {
                gap: 20px;
            }

            .pagination {
                margin-top: 30px;
            }
        }
    </style>

