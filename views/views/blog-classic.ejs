    <script>
        // Pagination functionality
        document.querySelectorAll('.page-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                if (this.textContent === '←' || this.textContent === '<i class="fas fa-angle-right"></i>') return;

                document.querySelectorAll('.page-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        });

        // Search form
        document.querySelector('.blog-search-form').addEventListener('submit', function (e) {
            e.preventDefault();
            const keyword = document.querySelector('.blog-search-input').value;
            console.log('Searching for:', keyword);
        });

        // Category filter
        document.querySelectorAll('.blog-category-item').forEach(item => {
            item.addEventListener('click', function (e) {
                e.preventDefault();
                const category = this.querySelector('span').textContent;
                console.log('Category selected:', category);
            });
        });

        // Keyword tags
        document.querySelectorAll('.blog-keyword-tag').forEach(tag => {
            tag.addEventListener('click', function (e) {
                e.preventDefault();
                const keyword = this.textContent;
                console.log('Keyword selected:', keyword);
            });
        });
    </script>

