<%- include('partials/header.ejs') %>
    <style>
        /* FAQ Section */
        .faq-section {
            padding: 80px 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-label {
            color: #FF5722;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 15px;
        }

        .section-title {
            font-size: 42px;
            color: #1a1a2e;
        }

        .faq-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
        }

        /* FAQ List */
        .faq-list {
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        }

        .faq-item {
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            margin-bottom: 15px;
            overflow: hidden;
            transition: all 0.3s;
        }

        .faq-item:hover {
            border-color: #FF5722;
        }

        .faq-question {
            padding: 20px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            font-weight: 600;
            color: #1a1a2e;
            font-size: 16px;
        }

        .faq-icon {
            color: #FF5722;
            font-size: 24px;
            font-weight: bold;
            transition: transform 0.3s;
        }

        .faq-answer {
            padding: 0 25px;
            max-height: 0;
            overflow: hidden;
            transition: all 0.3s;
            color: #666;
            line-height: 1.7;
        }

        .faq-item.active .faq-answer {
            padding: 0 25px 20px;
            max-height: 200px;
        }

        .faq-item.active .faq-icon {
            transform: rotate(45deg);
        }

        .container-decoration {
            position: absolute;
            right: 20px;
            top: 20px;
            width: 100px;
            opacity: 0.1;
        }

        /* Appointment Form */
        .appointment-form {
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
            position: relative;
        }

        .form-title {
            font-size: 24px;
            color: #1a1a2e;
            margin-bottom: 30px;
            font-weight: 600;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .icon-input {
            position: relative;
        }

        .icon-input input,
        .icon-input select {
            width: 100%;
            padding: 14px 45px 14px 14px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            transition: border 0.3s;
        }

        .icon-input input:focus,
        .icon-input select:focus {
            outline: none;
            border-color: #FF5722;
        }

        .input-icon {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #999;
        }

        .book-btn {
            width: 100%;
            background: #FF5722;
            color: white;
            padding: 16px;
            border: none;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .book-btn:hover {
            background: #e64a19;
            transform: translateY(-2px);
        }

        @media (max-width: 968px) {
            .faq-layout {
                grid-template-columns: 1fr;
            }
        }
    </style>
    </head>

    <body>
        <!-- Page Hero -->
        <section class="page-hero">
            <div class="page-title">
                <div class="vertical-line"></div>
                <div class="page-text">
                    <h1 class="tlt">Faq</h1>
                    <div class="breadcrumb">
                        <a href="/">Home</a>
                        <i class="fa-solid fa-angle-right"></i>
                        <span>Login</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="faq-section">
            <div class="container">
                <div class="section-header">
                    <div class="section-label">OUR EXPERT TEAM MEMBERS</div>
                    <h2 class="section-title">What Details Are Required<br>for a Quote?</h2>
                </div>

                <div class="faq-layout">
                    <!-- FAQ List -->
                    <div class="faq-list">
                        <div class="faq-item active">
                            <div class="faq-question">
                                How can I track my shipment?
                                <span class="faq-icon">+</span>
                            </div>
                            <div class="faq-answer">
                                You can easily track your shipment by entering your Tracking ID into our online tracking
                                tool. Once submitted, you'll receive real-time updates on your shipment's location and
                                estimated delivery.
                            </div>
                        </div>

                        <div class="faq-item">
                            <div class="faq-question">
                                How do I get in touch with customer support?
                                <span class="faq-icon">+</span>
                            </div>
                            <div class="faq-answer">
                                You can reach our customer support team via phone, email, or live chat. We're available
                                24/7
                                to assist you with any questions or concerns.
                            </div>
                        </div>

                        <div class="faq-item">
                            <div class="faq-question">
                                What if my shipment is delayed or lost?
                                <span class="faq-icon">+</span>
                            </div>
                            <div class="faq-answer">
                                If your shipment is delayed or lost, please contact our customer support immediately.
                                We'll
                                investigate the issue and work to resolve it as quickly as possible.
                            </div>
                        </div>

                        <div class="faq-item">
                            <div class="faq-question">
                                Can I schedule recurring shipments?
                                <span class="faq-icon">+</span>
                            </div>
                            <div class="faq-answer">
                                Yes, we offer scheduled recurring shipments for businesses with regular shipping needs.
                                Contact our sales team to set up a customized shipping schedule.
                            </div>
                        </div>

                        <div class="faq-item">
                            <div class="faq-question">
                                What is your pricing model?
                                <span class="faq-icon">+</span>
                            </div>
                            <div class="faq-answer">
                                Our pricing is based on factors such as shipment weight, dimensions, destination, and
                                delivery speed. Request a quote for an accurate estimate.
                            </div>
                        </div>
                    </div>

                    <!-- Appointment Form -->
                    <div class="appointment-form">
                        <h3 class="form-title">Make An Appointment</h3>
                        <form>
                            <div class="form-group">
                                <div class="icon-input">
                                    <input type="text" placeholder="Your name">
                                    <span class="input-icon">👤</span>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="icon-input">
                                    <input type="email" placeholder="Your email">
                                    <span class="input-icon">✉️</span>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="icon-input">
                                    <input type="tel" placeholder="Phone Number">
                                    <span class="input-icon">📞</span>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="icon-input">
                                    <select>
                                        <option>Freight City</option>
                                        <option>New York</option>
                                        <option>Los Angeles</option>
                                        <option>Chicago</option>
                                    </select>
                                    <span class="input-icon">📍</span>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="icon-input">
                                    <input type="text" placeholder="Travel Unit">
                                    <span class="input-icon">📅</span>
                                </div>
                            </div>

                            <button type="submit" class="book-btn">Book An Appointment →</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>

        <script>
            const faqItems = document.querySelectorAll('.faq-item');

            faqItems.forEach(item => {
                const question = item.querySelector('.faq-question');

                question.addEventListener('click', () => {
                    // Close other items
                    faqItems.forEach(otherItem => {
                        if (otherItem !== item) {
                            otherItem.classList.remove('active');
                        }
                    });

                    // Toggle current item
                    item.classList.toggle('active');
                });
            });
        </script>
        <%- include('partials/footer.ejs') %>