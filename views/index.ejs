    <style>
        /* ===============================
           CARGO SECTION
        ================================ */



        /* Desktop: Infinite Scroll */
        .cargo-icons {
            display: flex;
            gap: 60px;
            align-items: center;
            animation: scroll 3s linear infinite alternate;
        }




        /* Keyframe for infinite scroll */
        @keyframes scroll {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(-2%);
            }
        }

        /* Pause animation on hover */
        .cargo-icons:hover {
            animation-play-state: paused;
        }

        /* Mobile: One at a time slider */
        @media (max-width: 768px) {
            .cargo {
                padding: 40px 0;
            }

            .cargo-icons {
                gap: 45px;
                animation: none;
                position: relative;
                width: 100%;
            }

            .cargo-icon {
                min-width: 100%;
                display: none;
                justify-content: center;
                align-items: center;
            }

            .cargo-icon.active {
                display: flex;
            }

            .cargo-icon img {
                height: 60px;
            }

            /* Mobile slider dots (optional) */
            .slider-dots {
                display: flex;
                justify-content: center;
                gap: 8px;
                margin-top: 25px;
            }

            .slider-dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.4);
                cursor: pointer;
                transition: all 0.3s ease;
            }

            .slider-dot.active {
                background: white;
                width: 24px;
                border-radius: 4px;
            }
        }

        @media (min-width: 769px) {
            .slider-dots {
                display: none;
            }
        }
    </style>

