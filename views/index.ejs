    <script>
        // Mobile Slider Functionality
        let activeSlideIndex = 0;
        let autoSlideTimer;

        const isMobileView = () => window.innerWidth <= 768;

        function initializeMobileSlider() {
            if (!isMobileView()) return;

            const sliderContainer = document.getElementById('cargoSlider');
            const mobileSlides = sliderContainer.querySelectorAll('.cargo-icon:not(.desktop-duplicate)');
            const dotsWrapper = document.getElementById('sliderDots');

            // Hide desktop duplicates on mobile
            document.querySelectorAll('.desktop-duplicate').forEach(element => {
                element.style.display = 'none';
            });

            // Create navigation dots
            dotsWrapper.innerHTML = '';
            mobileSlides.forEach((_, slideIndex) => {
                const dotElement = document.createElement('div');
                dotElement.className = 'slider-dot';

                if (slideIndex === 0) dotElement.classList.add('active');

                dotElement.addEventListener('click', () => goToSpecificSlide(slideIndex));
                dotsWrapper.appendChild(dotElement);
            });

            // Show first slide
            displaySlide(0);

            // Start auto sliding
            startAutoSlide();
        }

        function displaySlide(slideIndex) {
            if (!isMobileView()) return;

            const mobileSlides = document.querySelectorAll('.cargo-icon:not(.desktop-duplicate)');
            const dotElements = document.querySelectorAll('.slider-dot');

            // Remove active classes
            mobileSlides.forEach(slide => slide.classList.remove('active'));
            dotElements.forEach(dot => dot.classList.remove('active'));

            // Activate current slide
            if (mobileSlides[slideIndex]) {
                mobileSlides[slideIndex].classList.add('active');
                dotElements[slideIndex].classList.add('active');
            }

            activeSlideIndex = slideIndex;
        }

        function moveToNextSlide() {
            if (!isMobileView()) return;

            const mobileSlides = document.querySelectorAll('.cargo-icon:not(.desktop-duplicate)');
            activeSlideIndex = (activeSlideIndex + 1) % mobileSlides.length;

            displaySlide(activeSlideIndex);
        }

        function goToSpecificSlide(slideIndex) {
            displaySlide(slideIndex);
            stopAutoSlide();
            startAutoSlide();
        }

        function startAutoSlide() {
            if (!isMobileView()) return;

            stopAutoSlide();
            autoSlideTimer = setInterval(moveToNextSlide, 3000);
        }

        function stopAutoSlide() {
            if (autoSlideTimer) {
                clearInterval(autoSlideTimer);
            }
        }

        function resetForDesktopView() {
            const allSlides = document.querySelectorAll('.cargo-icon');
            const dotsWrapper = document.getElementById('sliderDots');

            // Restore all slides
            allSlides.forEach(slide => {
                slide.classList.remove('active');
                slide.style.display = '';
            });

            // Remove dots
            dotsWrapper.innerHTML = '';

            stopAutoSlide();
        }

        function handleInitialLoad() {
            if (isMobileView()) {
                initializeMobileSlider();
            }
        }

        // Resize handler
        let resizeDebounceTimer;

        window.addEventListener('resize', () => {
            clearTimeout(resizeDebounceTimer);

            resizeDebounceTimer = setTimeout(() => {
                if (isMobileView()) {
                    initializeMobileSlider();
                } else {
                    resetForDesktopView();
                }
            }, 250);
        });

        // Run on load
        handleInitialLoad();

        // Pause when tab is hidden
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                stopAutoSlide();
            } else if (isMobileView()) {
                startAutoSlide();
            }
        });
    </script>



