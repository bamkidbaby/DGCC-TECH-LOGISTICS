        <script>
            // Add smooth scroll behavior
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });

            // Add active state to social links
            document.querySelectorAll('.social-link').forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    // Add your social media link functionality here
                    console.log('Social link clicked:', this.querySelector('i').className);
                });
            });

            // Parallax effect on scroll
            window.addEventListener('scroll', () => {
                const cards = document.querySelectorAll('.team-card');
                cards.forEach(card => {
                    const rect = card.getBoundingClientRect();
                    const scrollPercent = (window.innerHeight - rect.top) / window.innerHeight;
                    if (scrollPercent > 0 && scrollPercent < 1) {
                        const image = card.querySelector('.team-image');
                        if (image) {
                            image.style.transform = `scale(${1 + scrollPercent * 0.05})`;
                        }
                    }
                });
            });
        </script>


