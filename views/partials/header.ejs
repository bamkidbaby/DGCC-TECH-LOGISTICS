    <script>
        // Mobile Menu JavaScript
        // Handles menu opening/closing, dropdown toggles, and smooth animations

        document.addEventListener('DOMContentLoaded', function () {
            // Cache DOM elements
            const mobileMenu = document.querySelector('.mobile-menu');
            const mobileBg = document.querySelector('.mobile-bg');
            const menuToggleBtn = document.querySelector('.mobile-menu-toggle'); // Add this button to your main nav
            const closeBtn = document.querySelector('.mobile-menu .fa-times');
            const dropdownToggles = document.querySelectorAll('.mobile-menu .dropdown-toggle');

            // Open mobile menu
            function openMenu() {
                mobileMenu.style.transform = 'translateX(0)';
                mobileBg.classList.add('active');
                document.body.style.overflow = 'hidden';
            }

            // Close mobile menu
            function closeMenu() {
                mobileMenu.style.transform = 'translateX(-100%)';
                mobileBg.classList.remove('active');
                document.body.style.overflow = '';

                // Close all dropdowns when menu closes
                const openDropdowns = document.querySelectorAll('.mobile-menu .dropdown-menu');
                openDropdowns.forEach(dropdown => {
                    dropdown.style.display = 'none';
                    dropdown.style.maxHeight = '0';
                });

                // Reset all icons
                const allIcons = document.querySelectorAll('.mobile-menu .dropdown-icon i');
                allIcons.forEach(icon => {
                    icon.classList.remove('fa-angle-up');
                    icon.classList.add('fa-angle-down');
                });
            }

            // Toggle dropdown menus
            function toggleDropdown(e) {
                e.preventDefault();

                const parentLi = e.currentTarget.parentElement;
                const dropdownMenu = parentLi.querySelector('.dropdown-menu');
                const icon = e.currentTarget.querySelector('.dropdown-icon i');

                if (!dropdownMenu) return;

                // Check if dropdown is currently open
                const isOpen = dropdownMenu.style.display === 'block';

                if (isOpen) {
                    // Close dropdown
                    dropdownMenu.style.maxHeight = '0';
                    setTimeout(() => {
                        dropdownMenu.style.display = 'none';
                    }, 300);
                    icon.classList.remove('fa-angle-up');
                    icon.classList.add('fa-angle-down');
                } else {
                    // Open dropdown
                    dropdownMenu.style.display = 'block';
                    const scrollHeight = dropdownMenu.scrollHeight;
                    dropdownMenu.style.maxHeight = scrollHeight + 'px';
                    icon.classList.remove('fa-angle-down');
                    icon.classList.add('fa-angle-up');
                }
            }

            // Event listeners
            if (menuToggleBtn) {
                menuToggleBtn.addEventListener('click', openMenu);
            }

            if (closeBtn) {
                closeBtn.addEventListener('click', closeMenu);
            }

            if (mobileBg) {
                mobileBg.addEventListener('click', closeMenu);
            }

            // Add dropdown toggle listeners
            dropdownToggles.forEach(toggle => {
                toggle.addEventListener('click', toggleDropdown);
            });

            // Handle escape key to close menu
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && mobileMenu.style.transform === 'translateX(0px)') {
                    closeMenu();
                }
            });

            // Handle window resize - close menu on desktop
            let resizeTimer;
            window.addEventListener('resize', function () {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(function () {
                    if (window.innerWidth > 991) {
                        closeMenu();
                    }
                }, 250);
            });
        });
    </script>
