    <style>
        /* Mobile Menu Styles */
        .mobile-menu-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 9998;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .mobile-menu-overlay.active {
            display: block;
            opacity: 1;
        }

        .mobile-menu {
            position: fixed;
            top: 0;
            right: -100%;
            width: 320px;
            max-width: 85%;
            height: 100vh;
            background: #fff;
            z-index: 9999;
            transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: -5px 0 25px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .mobile-menu.active {
            right: 0;
        }

        /* Mobile Menu Header */
        .mobile-menu-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 25px;
            border-bottom: 1px solid #e0e0e0;
            background: #f8f9fa;
        }

        .mobile-menu-logo {
            flex: 1;
        }

        .mobile-menu-logo img {
            height: 35px;
            width: auto;
        }

        .mobile-menu-close {
            width: 40px;
            height: 40px;
            border: none;
            background: #2c3192;
            color: white;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            transition: all 0.3s ease;
            flex-shrink: 0;
        }

        .mobile-menu-close:hover {
            background: #e2b40e;
            transform: rotate(90deg);
        }

        .mobile-menu-close i {
            pointer-events: none;
        }

        /* Mobile Menu Content */
        .mobile-menu-content {
            flex: 1;
            overflow-y: auto;
            padding: 15px 0;
        }

        .mobile-menu-content::-webkit-scrollbar {
            width: 5px;
        }

        .mobile-menu-content::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        .mobile-menu-content::-webkit-scrollbar-thumb {
            background: #2c3192;
            border-radius: 10px;
        }

        .mobile-menu-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .mobile-menu-item {
            border-bottom: 1px solid #f0f0f0;
        }

        .mobile-menu-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 25px;
            color: #222;
            text-decoration: none;
            font-weight: 500;
            font-size: 15px;
            transition: all 0.3s ease;
        }

        .mobile-menu-link:hover {
            background: #f8f9fa;
            color: #2c3192;
            padding-left: 30px;
        }

        /* Mobile Dropdown */
        .mobile-dropdown-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #f0f0f0;
            transition: all 0.3s ease;
        }

        .mobile-dropdown-icon i {
            font-size: 12px;
            transition: transform 0.3s ease;
        }

        .has-dropdown.active>.mobile-menu-link .mobile-dropdown-icon,
        .has-dropdown.active>.mobile-dropdown-link .mobile-dropdown-icon {
            background: #2c3192;
            color: white;
        }

        .has-dropdown.active>.mobile-menu-link .mobile-dropdown-icon i,
        .has-dropdown.active>.mobile-dropdown-link .mobile-dropdown-icon i {
            transform: rotate(180deg);
        }

        .mobile-dropdown-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            max-height: 0;
            overflow: hidden;
            background: #f8f9fa;
            transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .mobile-dropdown-menu.active {
            max-height: 1000px;
        }

        .mobile-dropdown-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 25px 12px 40px;
            color: #555;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s ease;
            border-bottom: 1px solid #e8e8e8;
        }

        .mobile-dropdown-link:hover {
            background: #fff;
            color: #2c3192;
            padding-left: 45px;
        }

        /* Nested Dropdown */
        .mobile-dropdown-nested {
            background: #fff;
        }

        .mobile-dropdown-nested .mobile-dropdown-link {
            padding-left: 55px;
        }

        .mobile-dropdown-nested .mobile-dropdown-link:hover {
            padding-left: 60px;
        }

        /* Mobile Menu Footer */
        .mobile-menu-footer {
            padding: 20px 25px;
            border-top: 1px solid #e0e0e0;
            background: #f8f9fa;
        }

        .mobile-menu-cta {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            padding: 15px 25px;
            background: #e2b40e;
            color: white;
            text-decoration: none;
            border-radius: 50px;
            font-weight: 600;
            font-size: 15px;
            margin-bottom: 15px;
            transition: all 0.3s ease;
        }

        .mobile-menu-cta:hover {
            background: #2c3192;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(44, 49, 146, 0.3);
        }

        .mobile-menu-icons {
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        .mobile-menu-icon-btn {
            position: relative;
            width: 45px;
            height: 45px;
            border: 2px solid #e0e0e0;
            background: white;
            color: #2c3192;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .mobile-menu-icon-btn:hover {
            background: #2c3192;
            color: white;
            border-color: #2c3192;
        }

        .mobile-icon-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #e2b40e;
            color: white;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 600;
        }

        /* Hide mobile menu elements on desktop */
        @media (min-width: 992px) {

            .mobile-menu-toggle,
            .mobile-menu,
            .mobile-menu-overlay {
                display: none !important;
            }
        }

        /* Show mobile menu on tablets and mobile */
        @media (max-width: 991px) {
            .mobile-menu-toggle {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 10px 15px;
                background: #2c3192;
                color: white;
                border: none;
                border-radius: 5px;
                cursor: pointer;
                font-weight: 600;
                font-size: 14px;
                transition: all 0.3s ease;
            }

            .mobile-menu-toggle:hover {
                background: #e2b40e;
            }

            .mobile-menu-toggle i {
                font-size: 16px;
            }
        }

        /* Prevent body scroll when menu is open */
        body.mobile-menu-open {
            overflow: hidden;
        }

        /* Animation for menu items */
        @keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(20px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .mobile-menu.active .mobile-menu-item {
            animation: slideInRight 0.3s ease forwards;
        }

        .mobile-menu.active .mobile-menu-item:nth-child(1) {
            animation-delay: 0.1s;
        }

        .mobile-menu.active .mobile-menu-item:nth-child(2) {
            animation-delay: 0.15s;
        }

        .mobile-menu.active .mobile-menu-item:nth-child(3) {
            animation-delay: 0.2s;
        }

        .mobile-menu.active .mobile-menu-item:nth-child(4) {
            animation-delay: 0.25s;
        }

        .mobile-menu.active .mobile-menu-item:nth-child(5) {
            animation-delay: 0.3s;
        }

        .mobile-menu.active .mobile-menu-item:nth-child(6) {
            animation-delay: 0.35s;
        }

        /* Responsive adjustments */
        @media (max-width: 480px) {
            .mobile-menu {
                width: 100%;
                max-width: 100%;
            }

            .mobile-menu-header {
                padding: 15px 20px;
            }

            .mobile-menu-link {
                padding: 14px 20px;
                font-size: 14px;
            }

            .mobile-dropdown-link {
                padding: 11px 20px 11px 35px;
                font-size: 13px;
            }

            .mobile-dropdown-nested .mobile-dropdown-link {
                padding-left: 50px;
            }

            .mobile-menu-footer {
                padding: 15px 20px;
            }

            .mobile-menu-cta {
                padding: 13px 20px;
                font-size: 14px;
            }
        }
    </style>

    <script>
        // Mobile Menu Functionality
        document.addEventListener('DOMContentLoaded', function () {
            const mobileMenuToggle = document.getElementById('mobileMenuToggle');
            const mobileMenu = document.getElementById('mobileMenu');
            const mobileMenuClose = document.getElementById('mobileMenuClose');
            const mobileMenuOverlay = document.getElementById('mobileMenuOverlay');
            const body = document.body;

            // Open mobile menu
            function openMobileMenu() {
                mobileMenu.classList.add('active');
                mobileMenuOverlay.classList.add('active');
                body.classList.add('mobile-menu-open');
            }

            // Close mobile menu
            function closeMobileMenu() {
                mobileMenu.classList.remove('active');
                mobileMenuOverlay.classList.remove('active');
                body.classList.remove('mobile-menu-open');
            }

            // Toggle menu button
            if (mobileMenuToggle) {
                mobileMenuToggle.addEventListener('click', openMobileMenu);
            }

            // Close button
            if (mobileMenuClose) {
                mobileMenuClose.addEventListener('click', closeMobileMenu);
            }

            // Overlay click
            if (mobileMenuOverlay) {
                mobileMenuOverlay.addEventListener('click', closeMobileMenu);
            }

            // Close on ESC key
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && mobileMenu.classList.contains('active')) {
                    closeMobileMenu();
                }
            });

            // Dropdown functionality
            const dropdownToggles = document.querySelectorAll('.mobile-menu .has-dropdown > a');

            dropdownToggles.forEach(toggle => {
                toggle.addEventListener('click', function (e) {
                    e.preventDefault();

                    const parentItem = this.closest('.has-dropdown');
                    const dropdownMenu = parentItem.querySelector('.mobile-dropdown-menu');

                    // Toggle active class
                    parentItem.classList.toggle('active');
                    dropdownMenu.classList.toggle('active');

                    // Close other dropdowns at the same level
                    const siblings = Array.from(parentItem.parentElement.children).filter(
                        item => item !== parentItem && item.classList.contains('has-dropdown')
                    );

                    siblings.forEach(sibling => {
                        sibling.classList.remove('active');
                        const siblingDropdown = sibling.querySelector('.mobile-dropdown-menu');
                        if (siblingDropdown) {
                            siblingDropdown.classList.remove('active');
                        }
                    });
                });
            });

            // Close menu when clicking on non-dropdown links
            const mobileLinks = document.querySelectorAll('.mobile-menu-link:not(.has-dropdown > .mobile-menu-link), .mobile-dropdown-link:not(.has-dropdown > .mobile-dropdown-link)');

            mobileLinks.forEach(link => {
                link.addEventListener('click', function () {
                    // Don't close if it's a dropdown toggle
                    if (!this.nextElementSibling || !this.nextElementSibling.classList.contains('mobile-dropdown-menu')) {
                        closeMobileMenu();
                    }
                });
            });

            // Smooth scroll prevention when menu is open
            let startY = 0;
            mobileMenu.addEventListener('touchstart', function (e) {
                startY = e.touches[0].pageY;
            }, { passive: true });

            mobileMenu.addEventListener('touchmove', function (e) {
                const scrollTop = mobileMenu.querySelector('.mobile-menu-content').scrollTop;
                const scrollHeight = mobileMenu.querySelector('.mobile-menu-content').scrollHeight;
                const height = mobileMenu.querySelector('.mobile-menu-content').clientHeight;
                const currentY = e.touches[0].pageY;

                if ((scrollTop === 0 && currentY > startY) ||
                    (scrollTop + height === scrollHeight && currentY < startY)) {
                    e.preventDefault();
                }
            }, { passive: false });
        });
    </script>

