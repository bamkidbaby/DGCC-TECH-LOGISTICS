<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Details - MKS Logistics</title>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-navy: #0a1929;
            --accent-orange: #ff5722;
            --text-dark: #222;
            --text-gray: #666;
            --bg-light: #f5f7fa;
            --border-color: #e0e0e0;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg-light);
            color: var(--text-dark);
            line-height: 1.7;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 60px 20px;
        }

        /* Layout */
        .project-layout {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 40px;
        }

        /* Main Content */
        .project-main {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        .project-hero-image {
            width: 100%;
            height: 400px;
            border-radius: 15px;
            object-fit: cover;
            margin-bottom: 30px;
        }

        .project-header h1 {
            font-family: 'Syne', sans-serif;
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--primary-navy);
            margin-bottom: 20px;
        }

        .project-description {
            color: var(--text-gray);
            font-size: 1rem;
            line-height: 1.8;
            margin-bottom: 25px;
        }

        .section-title {
            font-family: 'Syne', sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary-navy);
            margin: 40px 0 20px;
        }

        /* Project Highlight Box */
        .project-highlight {
            background: var(--bg-light);
            border-radius: 15px;
            padding: 30px;
            margin: 30px 0;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
            align-items: center;
        }

        .highlight-image {
            width: 100%;
            height: 100%;
            border-radius: 12px;
            object-fit: cover;
        }

        .highlight-content h3 {
            font-family: 'Syne', sans-serif;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary-navy);
            margin-bottom: 15px;
        }

        .highlight-list {
            list-style: none;
            padding: 0;
        }

        .highlight-list li {
            padding: 8px 0;
            padding-left: 25px;
            position: relative;
            color: var(--text-gray);
            font-size: 0.95rem;
        }

        .highlight-list li::before {
            content: '✓';
            position: absolute;
            left: 0;
            color: var(--accent-orange);
            font-weight: bold;
        }

        /* Sidebar */
        .project-sidebar {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .sidebar-card {
            background: white;
            border-radius: 15px;
            padding: 30px 25px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        .sidebar-card h3 {
            font-family: 'Syne', sans-serif;
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--primary-navy);
            margin-bottom: 20px;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px 0;
            border-bottom: 1px solid var(--border-color);
        }

        .info-item:last-child {
            border-bottom: none;
        }

        .info-icon {
            width: 45px;
            height: 45px;
            background: var(--bg-light);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-orange);
            font-size: 18px;
            flex-shrink: 0;
        }

        .info-content h4 {
            font-size: 0.85rem;
            color: var(--text-gray);
            font-weight: 600;
            margin-bottom: 3px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .info-content p {
            font-size: 1rem;
            color: var(--text-dark);
            font-weight: 600;
        }

        /* Contact Info Card */
        .contact-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-gray);
            font-size: 0.95rem;
        }

        .contact-item i {
            color: var(--accent-orange);
            width: 20px;
        }

        /* Brochures Card */
        .brochure-button {
            width: 100%;
            background: var(--accent-orange);
            color: white;
            border: none;
            border-radius: 50px;
            padding: 15px 25px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .brochure-button:hover {
            background: #e64a19;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 87, 34, 0.3);
        }

        .company-profile-btn {
            background: white;
            color: var(--primary-navy);
            border: 2px solid var(--border-color);
        }

        .company-profile-btn:hover {
            background: var(--bg-light);
            border-color: var(--accent-orange);
            color: var(--accent-orange);
        }

        /* Responsive */
        @media (max-width: 968px) {
            .project-layout {
                grid-template-columns: 1fr;
            }

            .project-highlight {
                grid-template-columns: 1fr;
            }

            .project-hero-image {
                height: 300px;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 40px 15px;
            }

            .project-main {
                padding: 25px 20px;
            }

            .project-header h1 {
                font-size: 1.8rem;
            }

            .section-title {
                font-size: 1.3rem;
            }

            .project-hero-image {
                height: 250px;
            }

            .sidebar-card {
                padding: 25px 20px;
            }
        }

        @media (max-width: 480px) {
            .project-main {
                padding: 20px 15px;
            }

            .project-header h1 {
                font-size: 1.5rem;
            }

            .project-hero-image {
                height: 200px;
            }

            .project-highlight {
                padding: 20px;
            }

            .sidebar-card {
                padding: 20px 15px;
            }

            .info-item {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="project-layout">
            <!-- Main Content -->
            <div class="project-main">
                <!-- Hero Image -->
                <img src="https://images.unsplash.com/photo-1578575437130-527eed3abbec?w=800&h=500&fit=crop"
                    alt="MKS Logistics Project" class="project-hero-image">

                <!-- Project Header -->
                <div class="project-header">
                    <h1>MKS Logistics Project V.1</h1>
                    <p class="project-description">
                        Our Ocean Freight Services offer comprehensive solutions for all your shipping needs, ensuring
                        your cargo is transported safely, cost-effectively, and timely. Whether you're shipping FCL
                        (Full Container Load) or LCL (Less than Container Load) cargo, or even heavy cargo, our
                        comprehensive services meet all aspects of your sea shipping needs.
                    </p>
                    <p class="project-description">
                        With our Ocean Freight Services, we handle all aspects of your sea shipping needs, from
                        documentation to delivery, ensuring smooth transit and competitive pricing. We navigate the
                        complexities of international trade regulations, making this seamless and efficient for you.
                    </p>
                </div>

                <!-- Project Details Section -->
                <h2 class="section-title">Project details</h2>
                <p class="project-description">
                    With our Ocean Freight Services, we handle all aspects of your sea shipping needs, from
                    documentation to delivery, ensuring smooth transit and competitive pricing. We navigate the
                    complexities of international trade regulations and offer business operational support digging into
                    navigate the complexities of international trade.
                </p>

                <!-- Highlight Box -->
                <div class="project-highlight">
                    <img src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=500&h=350&fit=crop"
                        alt="Project Highlight" class="highlight-image">
                    <div class="highlight-content">
                        <h3>Translog Around the World</h3>
                        <p style="color: var(--text-gray); margin-bottom: 15px; font-size: 0.95rem;">
                            Three core values define the spirit of our culture
                        </p>
                        <ul class="highlight-list">
                            <li>Ocean freight offers predictable transit times.</li>
                            <li>It embody one of the most economical.</li>
                            <li>Suitable for most, modern shipping services.</li>
                            <li>We are all about quality transport company.</li>
                        </ul>
                    </div>
                </div>

                <p class="project-description">
                    Freight forwarders often offer consolidated cargo services, where LCL cargo combines multiple
                    shipments from multiple companies into a full container. FCL (Full Container Load) is typically used
                    when you have enough cargo to fill an entire container. It offers advantages similar to LCL but
                    without the consolidation process.
                </p>
                <p class="project-description">
                    This is a cost-effective option for smaller shipments. Your goods are consolidated with other
                    shippers, and you only pay for the space your cargo occupies. It can take longer as it involves
                    additional cost.
                </p>
            </div>

            <!-- Sidebar -->
            <div class="project-sidebar">
                <!-- Project Information -->
                <div class="sidebar-card">
                    <h3>Project Information</h3>
                    <div class="info-item">
                        <div class="info-icon">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="info-content">
                            <h4>Client</h4>
                            <p>Mark Anthonica</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-icon">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <div class="info-content">
                            <h4>Location</h4>
                            <p>Port au Mount Stanford</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-icon">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <div class="info-content">
                            <h4>Project Date</h4>
                            <p>January 22, 2025</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-icon">
                            <i class="fas fa-tag"></i>
                        </div>
                        <div class="info-content">
                            <h4>Category</h4>
                            <p>Sea Logistics</p>
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-icon">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div class="info-content">
                            <h4>Duration</h4>
                            <p>45 Days, 300</p>
                        </div>
                    </div>
                </div>

                <!-- Contact Info -->
                <div class="sidebar-card">
                    <h3>Contact Info</h3>
                    <div class="contact-list">
                        <div class="contact-item">
                            <i class="fas fa-phone"></i>
                            <span>+33 (0)6 Anveal, Australia</span>
                        </div>
                        <div class="contact-item">
                            <i class="fas fa-envelope"></i>
                            <span>contact@gmhed.com</span>
                        </div>
                    </div>
                </div>

                <!-- Brochures -->
                <div class="sidebar-card">
                    <h3>Brochures</h3>
                    <button class="brochure-button">
                        <i class="fas fa-download"></i>
                        Download Brochure
                    </button>
                    <button class="brochure-button company-profile-btn">
                        <i class="fas fa-file-pdf"></i>
                        Company Profile
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Download button functionality
        document.querySelectorAll('.brochure-button').forEach(button => {
            button.addEventListener('click', function () {
                const buttonText = this.textContent.trim();
                console.log('Download clicked:', buttonText);
                // Add your download logic here
                alert(`Downloading ${buttonText}...`);
            });
        });

        // Smooth scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
</body>

</html>