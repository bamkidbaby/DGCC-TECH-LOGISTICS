<%- include('partials/header.ejs') %>
    <section class="page-hero">
        <div class="page-title">
            <div class="vertical-line"></div>
            <div class="page-text">
                <h1>Blog Single</h1>
                <div class="breadcrumb">
                    <a href="/">Home</a>
                    <i class="fas fa-angle-right"></i>
                    <span>Blog Single</span>
                </div>
            </div>
        </div>
    </section>

    <style>
        :root {
            --primary-navy: #0a1929;
            --accent-orange: #e2b40e;
            --text-dark: #222;
            --text-gray: #666;
            --bg-light: #f5f7fa;
            --border-color: #e0e0e0;
        }

        .blog-single-container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 60px 20px;
        }

        /* Hero Image */
        .post-hero-image {
            width: 100%;
            height: 400px;
            border-radius: 20px;
            object-fit: cover;
            margin-bottom: 30px;
        }

        /* Author Info */
        .post-author-info {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
            padding-bottom: 25px;
            border-bottom: 1px solid var(--border-color);
        }

        .author-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
        }

        .author-details h4 {
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 3px;
            font-size: 0.95rem;
        }

        .author-meta {
            display: flex;
            gap: 15px;
            font-size: 0.85rem;
            color: var(--text-gray);
        }

        .author-meta span {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        /* Post Title */
        .post-title {
            font-size: 2.75rem;
            font-weight: 600;
            color: var(--primary-navy);
            line-height: 1.2;
            margin-bottom: 25px;
        }

        /* Post Content */
        .post-content {
            font-size: 1rem;
            line-height: 1.8;
            color: var(--text-gray);
        }

        .post-content p {
            margin-bottom: 20px;
        }

        .post-content h2 {
            font-family: 'Syne', sans-serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary-navy);
            margin: 40px 0 20px;
        }

        .post-content h3 {
            font-family: 'Syne', sans-serif;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary-navy);
            margin: 35px 0 18px;
        }

        /* Quote Block */
        .quote-block {
            background: #fff;
            border-left: 4px solid var(--accent-orange);
            padding: 25px 30px;
            margin: 30px 0;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        }

        .quote-block p {
            font-style: italic;
            color: var(--text-dark);
            font-size: 1.05rem;
            margin: 0;
        }

        /* Image Grid */
        .content-image-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin: 35px 0;
        }

        .content-image {
            width: 100%;
            height: 250px;
            border-radius: 15px;
            object-fit: cover;
        }

        /* List Styling */
        .post-content ul {
            margin: 20px 0;
            padding-left: 25px;
        }

        .post-content ul li {
            margin-bottom: 12px;
            position: relative;
            padding-left: 10px;
        }

        .post-content ul li::marker {
            color: var(--accent-orange);
        }

        /* Tags Section */
        .post-tags-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 30px 0;
            margin: 40px 0 30px;
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
            flex-wrap: wrap;
            gap: 20px;
        }

        .post-tags {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .post-tag {
            background: var(--bg-light);
            color: var(--text-dark);
            padding: 8px 18px;
            border-radius: 50px;
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

        .post-tag:hover {
            background: var(--accent-orange);
            color: white;
            border-color: var(--accent-orange);
        }

        .post-share {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .post-share span {
            font-weight: 600;
            color: var(--text-dark);
        }

        .share-icons {
            display: flex;
            gap: 8px;
        }

        .share-icon {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-dark);
            text-decoration: none;
            transition: all 0.3s ease;
            border: 1px solid var(--border-color);
        }

        .share-icon:hover {
            background: var(--accent-orange);
            color: white;
            border-color: var(--accent-orange);
            transform: translateY(-2px);
        }

        /* Comments Section */
        .comments-section {
            background: white;
            border-radius: 20px;
            padding: 40px;
            margin-top: 50px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        }

        .comments-header {
            font-family: 'Syne', sans-serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary-navy);
            margin-bottom: 30px;
        }

        /* Comment Item */
        .comment-item {
            display: flex;
            gap: 15px;
            padding: 25px 0;
            border-bottom: 1px solid var(--border-color);
        }

        .comment-item:last-child {
            border-bottom: none;
        }

        .comment-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
        }

        .comment-content {
            flex: 1;
        }

        .comment-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 8px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .comment-author {
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 3px;
            font-size: 1rem;
        }

        .comment-date {
            font-size: 0.85rem;
            color: var(--text-gray);
        }

        .comment-reply-btn {
            background: transparent;
            color: var(--accent-orange);
            border: none;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .comment-reply-btn:hover {
            color: #e64a19;
            text-decoration: underline;
        }

        .comment-text {
            color: var(--text-gray);
            line-height: 1.7;
            font-size: 0.95rem;
        }

        /* Leave Reply Section */
        .leave-reply-section {
            background: white;
            border-radius: 20px;
            padding: 40px;
            margin-top: 30px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        }

        .reply-title {
            font-family: 'Syne', sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--primary-navy);
            margin-bottom: 10px;
        }

        .reply-subtitle {
            color: var(--text-gray);
            margin-bottom: 30px;
            font-size: 0.95rem;
        }

        .reply-form {
            display: grid;
            gap: 20px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group label {
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 8px;
            font-size: 0.9rem;
        }

        .form-group input,
        .form-group textarea {
            padding: 14px 18px;
            border: 2px solid var(--border-color);
            border-radius: 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            outline: none;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            border-color: var(--accent-orange);
        }

        .form-group textarea {
            resize: vertical;
            min-height: 150px;
        }

        .form-checkbox {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-top: 10px;
        }

        .form-checkbox input[type="checkbox"] {
            margin-top: 4px;
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .form-checkbox label {
            font-size: 0.9rem;
            color: var(--text-gray);
            line-height: 1.5;
        }

        .submit-comment-btn {
            background: var(--accent-orange);
            color: white;
            padding: 15px 40px;
            border: none;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            width: fit-content;
            box-shadow: 0 4px 15px rgba(255, 87, 34, 0.3);
        }

        .submit-comment-btn:hover {
            background: #e64a19;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 87, 34, 0.4);
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .container {
                padding: 40px 15px;
            }

            .post-hero-image {
                height: 280px;
                border-radius: 15px;
            }

            .post-title {
                font-size: 1.8rem;
            }

            .post-content h2 {
                font-size: 1.5rem;
            }

            .post-content h3 {
                font-size: 1.2rem;
            }

            .content-image-grid {
                grid-template-columns: 1fr 1fr;
                gap: 15px;
            }

            .content-image {
                height: 220px;
            }

            .post-tags-section {
                flex-direction: column;
                align-items: flex-start;
            }

            .comments-section,
            .leave-reply-section {
                padding: 25px 20px;
            }

            .comments-header {
                font-size: 1.5rem;
            }

            .reply-title {
                font-size: 1.4rem;
            }

            .form-row {
                grid-template-columns: 1fr;
                gap: 15px;
            }

            .comment-item {
                flex-direction: column;
            }
        }

        @media (max-width: 480px) {
            .container {
                padding: 30px 12px;
            }

            .post-hero-image {
                height: 220px;
            }

            .post-title {
                font-size: 1.5rem;
            }

            .post-author-info {
                flex-direction: column;
                align-items: flex-start;
            }

            .quote-block {
                padding: 20px;
            }

            .comments-section,
            .leave-reply-section {
                padding: 20px 15px;
            }

            .post-share {
                flex-direction: column;
                align-items: flex-start;
            }

            .submit-comment-btn {
                width: 100%;
            }
        }
    </style>
    </head>

