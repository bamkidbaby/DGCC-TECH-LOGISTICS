<%- include('partials/header.ejs') %>
    <link rel="stylesheet" href="/styles/about.css">
    <section class="page-hero">
        <div class="page-title">
            <div class="vertical-line"></div>
            <div class="page-text">
                <h1>About Us</h1>
                <div class="breadcrumb">
                    <a href="/">Home</a> <i class="fas fa-arrow-right"></i> <span>About Us</span>
                </div>
            </div>
        </div>
    </section>
    <section class="work-process">
        <div class="container">
            <div class="section-label" style="align-items: center; display: flex;">
                <i class="fa-solid fa-truck-fast"></i> WORKING PROCESS
            </div>
            <h2>Logistics Solutions to Help<br>Businesses</h2>
            <div class="process-steps">
                <div class="step">
                    <div class="step-number">01</div>
                    <div class="step-icon"
                        style="background: url('https://html.theme-village.com/transhub/demo/images/st1.png') center/cover;">

                    </div>
                    <h3>Select Services</h3>
                    <p>Lorain Air freight service deliver knowledge opportunity</p>
                </div>
                <i class="fas fa-angle-double-right"></i>

                <div class="step">
                    <div class="step-number">02</div>
                    <div class="step-icon"
                        style="background: url('https://html.theme-village.com/transhub/demo/images/st2.png') center/cover;">

                    </div>
                    <h3>Parcel Information</h3>
                    <p>Lorain Air freight service deliver knowledge opportunity</p>
                </div>
                <i class="fas fa-angle-double-right"></i>
                <div class="step">
                    <div class="step-number">03</div>
                    <div class="step-icon"
                        style="background: url('https://html.theme-village.com/transhub/demo/images/st3.png') center/cover;"">
    
                    </div>
                    <h3>Transportation</h3>
                    <p>Lorain Air freight service deliver knowledge opportunity</p>
                </div>
            </div>
        </div>
    </section>

    <section class=" about-section">
                        <div class="container">
                            <div class="about-grid">
                                <!-- Left Side - Image Collage -->
                                <div class="image-collage">
                                    <!-- Experience Badge -->
                                    <div class="experience-badge">
                                        25+ Years Experience
                                    </div>

                                    <!-- Main Image - Woman with helmet -->
                                    <div class="main-image">
                                        <img src="images/imgi_11_about-ft.jpg" alt="Professional worker">
                                        <div class="blue-circle"></div>
                                    </div>

                                    <!-- Container Image -->
                                    <div class="container-image">
                                        <img src="images/imgi_12_about-ft2.png" alt="Shipping container">
                                    </div>

                                    <!-- Center Icon Badge -->
                                    <div class="center-badge">
                                        <div class="badge-circle">
                                            <img src="images/imgi_14_ab-st2.png" alt="">
                                        </div>
                                    </div>

                                    <!-- Circular Truck Images -->
                                    <div class="truck-circle truck-circle-1">
                                        <img src="images/imgi_13_about-ft3.png" alt="Logistics truck">
                                    </div>



                                </div>

                                <!-- Right Side - Content -->
                                <div class="content-area">
                                    <!-- Section Label -->
                                    <div class="section-label">
                                        <i class="fas fa-truck"></i>
                                        <span>ABOUT OUR COMPANY</span>
                                    </div>

                                    <!-- Main Heading -->
                                    <h1 class="main-heading">
                                        Our services increase the productivity of your work.
                                    </h1>

                                    <!-- Description -->
                                    <p class="description">
                                        Our global logistics expertise, advanced supply chain technology & customized
                                        logistics solutions will help analyze, develop, and implement successful
                                    </p>

                                    <!-- Tab Navigation -->
                                    <div class="tab-navigation">
                                        <button class="tab-btn active">Our Mission</button>
                                        <button class="tab-btn">Our Vision</button>
                                        <button class="tab-btn">Our History</button>
                                    </div>
                                    <div class="line-divide"></div>
                                    <!-- Info Box with Image -->
                                    <div class="info-box">
                                        <div class="info-image">
                                            <img src="images/imgi_15_ab-t1.png" alt="Container port">
                                        </div>
                                        <div class="info-text">
                                            <p>
                                                Logistic & transport Group is a forward-thinking real estate consultancy
                                                and investment advisory firm with over 25 years of industry experience.
                                            </p>
                                            <p>
                                                We specialize in delivering strategic guidance, project development
                                                support,
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Bottom Text -->
                                    <p class="bottom-text">
                                        We specialize in delivering strategic guidance, project development support,
                                    </p>

                                    <!-- CTA Section -->
                                    <div class="cta-section">
                                        <a href="#" class="cta-btn">
                                            About Us
                                            <i class="fas fa-arrow-right"></i>
                                        </a>

                                        <div class="phone-info">
                                            <div class="phone-icon">
                                                <i class="fas fa-phone-alt"></i>
                                            </div>
                                            <div class="phone-text">
                                                <span class="phone-label">Call Us Any Time:</span>
                                                <span class="phone-number">148 359 505 285</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
    </section>


