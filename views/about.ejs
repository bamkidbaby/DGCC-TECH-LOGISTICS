                <img src="https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?w=300&h=350&fit=crop"
                    alt="Shane Darren" class="team-image">
                <div class="social-icon">📧</div>
                <div class="team-info">
                    <div class="team-name">Shane Darren</div>
                    <div class="team-role">Head of Operations</div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>