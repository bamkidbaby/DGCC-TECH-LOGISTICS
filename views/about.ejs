<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Company Section</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: white;
            padding: 60px 20px;
        }

        .about-section {
            max-width: 1200px;
            margin: 0 auto;
        }

        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: start;
        }

        .about-images {
            position: relative;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .about-image {
            width: 100%;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

        .experience-badge {
            position: absolute;
            top: 20px;
            left: 20px;
            background: #FF5722;
            color: white;
            padding: 15px 25px;
            border-radius: 10px;
            font-weight: 600;
        }

        .badge-number {
            font-size: 32px;
            display: block;
        }

        .icon-circle {
            width: 80px;
            height: 80px;
            background: #FF5722;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            position: absolute;
            bottom: 20px;
            right: 20px;
            box-shadow: 0 5px 20px rgba(255, 87, 34, 0.4);
        }

        .section-label {
            color: #FF5722;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 15px;
        }

        .about-content h2 {
            font-size: 36px;
            margin-bottom: 20px;
            color: #1a1a2e;
            line-height: 1.3;
        }

        .about-content p {
            color: #666;
            line-height: 1.8;
            margin-bottom: 30px;
        }

        .feature-tabs {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
        }

        .tab-btn {
            background: white;
            border: 2px solid #e0e0e0;
            padding: 10px 25px;
            border-radius: 25px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
        }

        .tab-btn.active {
            background: #FF5722;
            color: white;
            border-color: #FF5722;
        }

        .features-list {
            list-style: none;
        }

        .features-list li {
            padding: 12px 0;
            color: #666;
            display: flex;
            gap: 10px;
        }

        .features-list li:before {
            content: "→";
            color: #FF5722;
            font-weight: bold;
        }

        .cta-section {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-top: 30px;
        }

        .about-btn {
            background: #FF5722;
            color: white;
            padding: 14px 30px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s;
        }

        .about-btn:hover {
            background: #e64a19;
        }

        .call-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .call-icon {
            width: 50px;
            height: 50px;
            background: #1a2337;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
        }

        .call-text p {
            font-size: 13px;
            color: #999;
            margin: 0;
        }

        .call-number {
            color: #FF5722;
            font-weight: 600;
            font-size: 16px;
        }

        @media (max-width: 968px) {
            .about-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <div class="about-section">
        <div class="about-grid">
            <div class="about-images">
                <div style="position: relative;">
                    <img src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=300&h=400&fit=crop"
                        alt="Truck" class="about-image" style="margin-top: 60px;">
                </div>
                <div style="position: relative;">
                    <img src="https://images.unsplash.com/photo-1566576721346-d4a3b4eaeb55?w=300&h=400&fit=crop"
                        alt="Worker" class="about-image">
                    <div class="experience-badge">
                        <span class="badge-number">25+ Years</span>
                        Experience
                    </div>
                    <div class="icon-circle">⚙️</div>
                </div>
            </div>

            <div class="about-content">
                <div class="section-label">📦 ABOUT OUR COMPANY</div>
                <h2>Our services increase the productivity of your work.</h2>
                <p>Our global logistics expertise, advanced supply chain technology & customized logistics solutions
                    will help you analyze, develop and implement successful supply chain management strategies.</p>

                <div class="feature-tabs">
                    <button class="tab-btn active">Our Mission</button>
                    <button class="tab-btn">Our Vision</button>
                    <button class="tab-btn">Our History</button>
                </div>

                <ul class="features-list">
                    <li>Reliable and cost-effective freight services ensuring timely deliveries 24/7.</li>
                    <li>Comprehensive global logistics solutions by coordinating deliveries.</li>
                    <li>Expert warehousing and distribution services across countries.</li>
                </ul>

                <p style="margin-top: 20px;">We specialize in delivering strategic guidance, project development
                    support, logistics and information management...</p>

                <div class="cta-section">
                    <a href="#" class="about-btn">About Us →</a>
                    <div class="call-info">
                        <div class="call-icon">📞</div>
                        <div class="call-text">
                            <p>Call Us Any Time</p>
                            <div class="call-number">+88 123 456 7335</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Success Story Section</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0f1926;
            padding: 60px 20px;
        }

        .success-section {
            max-width: 1200px;
            margin: 0 auto;
        }

        .success-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }

        .section-label {
            color: #FF5722;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 20px;
        }

        .success-content h2 {
            font-size: 42px;
            color: white;
            margin-bottom: 40px;
            line-height: 1.3;
        }

        .quote-box {
            background: rgba(255, 255, 255, 0.05);
            border-left: 4px solid #FF5722;
            padding: 30px;
            border-radius: 10px;
            margin-bottom: 30px;
        }

        .quote-box p {
            color: #b8c5d6;
            line-height: 1.8;
            margin: 0;
        }

        .stats-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-item p {
            color: #b8c5d6;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .stat-arrow {
            color: #FF5722;
            font-size: 20px;
            margin-bottom: 10px;
        }

        .success-image-container {
            position: relative;
        }

        .success-main-image {
            width: 100%;
            border-radius: 20px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        }

        .info-card {
            position: absolute;
            bottom: 30px;
            right: 30px;
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            max-width: 250px;
        }

        .info-card h4 {
            font-size: 18px;
            color: #1a1a2e;
            margin-bottom: 10px;
        }

        .info-card p {
            color: #666;
            font-size: 13px;
            line-height: 1.6;
            margin-bottom: 15px;
        }

        .more-link {
            color: #FF5722;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        @media (max-width: 968px) {
            .success-grid {
                grid-template-columns: 1fr;
            }

            .success-content h2 {
                font-size: 32px;
            }
        }
    </style>
</head>

<body>
    <div class="success-section">
        <div class="success-grid">
            <div class="success-content">
