<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cart</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f5f5f5;
        }

        /* Page Hero */
        .page-hero {
            background: linear-gradient(rgba(26, 35, 55, 0.7), rgba(26, 35, 55, 0.7)), url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=1600&h=400&fit=crop') center/cover;
            padding: 100px 0 60px;
            color: white;
            text-align: center;
        }

        .page-hero h1 {
            font-size: 48px;
            margin-bottom: 15px;
        }

        .breadcrumb {
            display: flex;
            justify-content: center;
            gap: 10px;
            font-size: 14px;
        }

        .breadcrumb a {
            color: white;
            text-decoration: none;
        }

        .breadcrumb span {
            color: #FF5722;
        }

        /* Cart Section */
        .cart-section {
            padding: 60px 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .cart-layout {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 30px;
        }

        /* Cart Table */
        .cart-table-container {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        }

        .cart-table {
            width: 100%;
            border-collapse: collapse;
        }

        .cart-table thead {
            background: #f8f9fa;
        }

        .cart-table th {
            padding: 15px;
            text-align: left;
            font-weight: 600;
            color: #1a1a2e;
            border-bottom: 2px solid #e0e0e0;
        }

        .cart-table td {
            padding: 20px 15px;
            border-bottom: 1px solid #f0f0f0;
        }

        .product-cell {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .product-image {
            width: 80px;
            height: 80px;
            border-radius: 8px;
            object-fit: cover;
        }

        .product-name {
            font-weight: 600;
            color: #1a1a2e;
        }

        .product-price {
            font-size: 18px;
            color: #1a1a2e;
            font-weight: 600;
        }

        .quantity-control {
            display: flex;
            align-items: center;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            overflow: hidden;
            width: fit-content;
        }

        .qty-btn {
            width: 35px;
            height: 35px;
            border: none;
            background: #f5f5f5;
            cursor: pointer;
            font-size: 16px;
            transition: background 0.3s;
        }

        .qty-btn:hover {
            background: #e0e0e0;
        }

        .qty-display {
            width: 40px;
            text-align: center;
            border: none;
            font-weight: 600;
        }

        .remove-btn {
            background: #ff4444;
            color: white;
            border: none;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 18px;
            transition: all 0.3s;
        }

        .remove-btn:hover {
            background: #cc0000;
            transform: scale(1.1);
        }

        /* Cart Actions */
        .cart-actions {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #e0e0e0;
        }

        .coupon-section {
            display: flex;
            gap: 10px;
        }

        .coupon-input {
            padding: 12px 20px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            width: 250px;
        }

        .apply-btn {
            background: #4CAF50;
            color: white;
            padding: 12px 25px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.3s;
        }

        .apply-btn:hover {
            background: #45a049;
        }

        .continue-btn {
            background: #FF5722;
            color: white;
            padding: 12px 30px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .continue-btn:hover {
            background: #e64a19;
        }

        /* Cart Summary */
        .cart-summary {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
            height: fit-content;
        }

        .summary-title {
            font-size: 20px;
            color: #1a1a2e;
            margin-bottom: 20px;
            font-weight: 600;
        }

        .summary-item {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #f0f0f0;
        }

        .summary-label {
            color: #666;
            font-size: 14px;
        }

        .summary-value {
            color: #1a1a2e;
            font-weight: 600;
        }

        .summary-total {
            padding: 20px 0;
            font-size: 20px;
            font-weight: 700;
            color: #1a1a2e;
        }

        .summary-total .summary-value {
            color: #FF5722;
        }

        .checkout-btn {
            width: 100%;
            background: #FF5722;
            color: white;
            padding: 15px;
            border: none;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 20px;
        }

        .checkout-btn:hover {
            background: #e64a19;
            transform: translateY(-2px);
        }

        @media (max-width: 968px) {
            .cart-layout {
                grid-template-columns: 1fr;
            }

            .cart-table {
                font-size: 14px;
            }

            .product-image {
                width: 60px;
                height: 60px;
            }

            .cart-actions {
                flex-direction: column;
                gap: 15px;
            }

            .coupon-section {
                flex-direction: column;
            }

            .coupon-input {
                width: 100%;
            }
        }
    </style>
</head>

<body>
    <!-- Page Hero -->
    <section class="page-hero">
        <h1>Cart</h1>
        <div class="breadcrumb">
            <a href="#">Home</a> > <span>Cart</span>
        </div>
    </section>

    <!-- Cart Section -->
    <section class="cart-section">
        <div class="container">
            <div class="cart-layout">
                <!-- Cart Table -->
                <div class="cart-table-container">
                    <table class="cart-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <div class="product-cell">
                                        <img src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=100&h=100&fit=crop"
                                            alt="Product" class="product-image">
                                        <div class="product-name">Dell Red Sirion 18" Spacial</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="product-price">$85.00</div>
                                </td>
                                <td>
                                    <div class="quantity-control">
                                        <button class="qty-btn">-</button>
                                        <input type="text" class="qty-display" value="1" readonly>
                                        <button class="qty-btn">+</button>
                                    </div>
                                </td>
                                <td>
                                    <div class="product-price">$85.00</div>
                                </td>
                                <td>
                                    <button class="remove-btn">✕</button>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <div class="product-cell">
                                        <img src="https://images.unsplash.com/photo-1547949003-9792a18a2601?w=100&h=100&fit=crop"
                                            alt="Product" class="product-image">
                                        <div class="product-name">Doll Gloves Fertlizer Ofrtime</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="product-price">$50.00</div>
                                </td>
                                <td>
                                    <div class="quantity-control">
                                        <button class="qty-btn">-</button>
                                        <input type="text" class="qty-display" value="1" readonly>
                                        <button class="qty-btn">+</button>
                                    </div>
                                </td>
                                <td>
                                    <div class="product-price">$50.00</div>
                                </td>
                                <td>
                                    <button class="remove-btn">✕</button>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    <div class="product-cell">
                                        <img src="https://images.unsplash.com/photo-1434389677669-e08b4cac3105?w=100&h=100&fit=crop"
                                            alt="Product" class="product-image">
                                        <div class="product-name">Doll Emploie D'Chrome</div>
                                    </div>
                                </td>
                                <td>
                                    <div class="product-price">$60.00</div>
                                </td>
                                <td>
                                    <div class="quantity-control">
                                        <button class="qty-btn">-</button>
                                        <input type="text" class="qty-display" value="1" readonly>
                                        <button class="qty-btn">+</button>
                                    </div>
                                </td>
                                <td>
                                    <div class="product-price">$60.00</div>
                                </td>
                                <td>
                                    <button class="remove-btn">✕</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="cart-actions">
                        <div class="coupon-section">
                            <input type="text" class="coupon-input" placeholder="Coupon Code">
                            <button class="apply-btn">Apply Coupon</button>
                        </div>
                        <button class="continue-btn">Continue Shopping</button>
                    </div>
                </div>

                <!-- Cart Summary -->
                <div class="cart-summary">
                    <h3 class="summary-title">Products</h3>

                    <div class="summary-item">
                        <span class="summary-label">John's Elite 761</span>
                        <span class="summary-value">$45.00</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">John's Elite 761</span>
                        <span class="summary-value">$40.00</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">John's Elite 761</span>
                        <span class="summary-value">$40.00</span>
                    </div>

                    <div class="summary-item">
                        <span class="summary-label">Subtotal</span>
                        <span class="summary-value">$242.00</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Shipping Cost</span>
                        <span class="summary-value">$10.00</span>
                    </div>

                    <div class="summary-item summary-total">
                        <span class="summary-label">Total</span>
                        <span class="summary-value">$285.00</span>
                    </div>

                    <button class="checkout-btn">Proceed To Checkout</button>
                </div>
            </div>
        </div>
    </section>

    <script>
        // Quantity controls
        const qtyBtns = document.querySelectorAll('.qty-btn');

        qtyBtns.forEach(btn => {
            btn.addEventListener('click', function () {
                const qtyDisplay = this.parentElement.querySelector('.qty-display');
                let value = parseInt(qtyDisplay.value);

                if (this.textContent === '+') {
                    qtyDisplay.value = value + 1;
                } else if (value > 1) {
                    qtyDisplay.value = value - 1;
                }
            });
        });

        // Remove buttons
        const removeBtns = document.querySelectorAll('.remove-btn');

        removeBtns.forEach(btn => {
            btn.addEventListener('click', function () {
                if (confirm('Are you sure you want to remove this item?')) {
                    this.closest('tr').remove();
                }
            });
        });
    </script>
</body>

</html>